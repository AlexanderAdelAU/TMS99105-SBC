;***********************************************************************
;	DISK INITIALISER - "Dumb DSKINIT" (Driven by SYSGEN.C)
;***********************************************************************

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
SP	EQU	10
R11	EQU	11
PORT	EQU	12
R12	EQU	12
R13	EQU	13
R14	EQU	14
R15	EQU	15

	DXOP 	CALL,6
	DXOP 	RET,7
	DXOP 	PUSH,8
	DXOP 	POP,9
	DXOP 	WHEX,10
	DXOP 	READ,13
	DXOP 	WRITE,12
	DXOP 	MESG,14
	DXOP	DEBUG,15

MONITOR		EQU	0F000H
SHELL_ADDR	EQU	0C000H
LADDRESS	EQU	00A00H
WORKSP		EQU	0230H
STACKP  	EQU	0FFEH

	AORG	0500H
	JMP	START

;=====================================================================
BYTSEC		EQU	512
IDE_BYTSEC 	EQU	256
SECBLK		EQU	8
LBAPERSEC 	EQU	2
LBAPERBLK 	EQU	SECBLK*LBAPERSEC

FIRSTBLK 	EQU	8
LASTBLK		EQU	0FF80H

BOOT_LBA 	EQU	0
BAT_LBA		EQU	16
DIR_LBA		EQU	48
ALIAS_LBA	EQU	112

NDIRSEC		EQU	32
NALIASSEC	EQU	8
NBATPAGE 	EQU	16

NAMSIZ		EQU	11
DIRENTSZ 	EQU	32

FLA	EQU	16
FLD_ID	EQU	18
CRN	EQU	26
FSB	EQU	12
FSZ	EQU	14

;=====================================================================
; MAIN ENTRY POINT
;=====================================================================
	EVEN
START	LWPI	WORKSP
	LI	SP,STACKP

	CALL	@IDE_READY
	CALL	@INITBOOT		; 1. Write Bootloader to LBA 0
	CALL	@WIPEDISK		; 2. Wipe standard BAT, DIR, and ALIAS areas
	CALL	@INITSYS		; 3. Write dynamic PC Payload (overwrites Sector 0)

	MESG	@SUCCESS
	BLWP	@MONITOR

SUCCESS:BYTE	0DH,0AH
	TEXT	"SUCCESS..."
	BYTE	0DH,0AH,0
	EVEN

;=====================================================================
INITBOOT:
	LI	R3,LOADER
	LI	R5,BOOT_LBA
	CALL	@WRITE_SECTOR
	RET

;=====================================================================
WIPEDISK:
	; Wipe BAT Pages (0000H)
	CALL	@CLEARBUF
	LI	R5,BAT_LBA
	LI	R2,NBATPAGE
W_BAT:	LI	R3,IOBUF
	CALL	@WRITE_SECTOR
	INCT	R5
	DEC	R2
	JNE	W_BAT

	; Wipe DIR Sectors (E5E5H)
	CALL	@FILLDIRBUF
	LI	R5,DIR_LBA
	LI	R2,NDIRSEC
W_DIR:	LI	R3,IOBUF
	CALL	@WRITE_SECTOR
	INCT	R5
	DEC	R2
	JNE	W_DIR

	; Wipe Folder Alias Table (0000H)
	CALL	@CLEARBUF
	LI	R5,ALIAS_LBA
	LI	R2,NALIASSEC
W_ALI:	LI	R3,IOBUF
	CALL	@WRITE_SECTOR
	INCT	R5
	DEC	R2
	JNE	W_ALI
	RET

CLEARBUF:
	LI	R1,IOBUF
	LI	R0,BYTSEC/2
CBUF1:	CLR	*R1+
	DEC	R0
	JNE	CBUF1
	RET

FILLDIRBUF:
	LI	R1,IOBUF
	LI	R0,BYTSEC/2
	LI	R2,0E5E5H
FDBUF1:	MOV	R2,*R1+
	DEC	R0
	JNE	FDBUF1
	RET

;=====================================================================
; INITSYS - Dynamic File Writer (Driven by SYSGEN.C Write-Table)
;=====================================================================
INITSYS:
	; 1. Write the pre-computed BAT Sector 0
	LI	R5,BAT_LBA
	LI	R3,2000H		; SYSGEN placed BAT at >2000
	CALL	@WRITE_SECTOR

	; 2. Write the pre-computed Directory Sector 0
	LI	R5,DIR_LBA
	LI	R3,2200H		; SYSGEN placed DIR at >2200
	CALL	@WRITE_SECTOR

	; 3. Execute the Write-Table to dump all utilities to disk
	LI	R8,2400H		; SYSGEN placed Write-Table at >2400
WT_LOOP:
	MOV	*R8+,R3			; RAM_ADDR
	JEQ	WT_DONE			; 0000H terminates table
	MOV	*R8+,R5			; LBA_START
	MOV	*R8+,R6			; SECTOR_COUNT
WT_SEC:
	CALL	@WRITE_SECTOR
	AI	R3,512			; Advance RAM chunk
	INCT	R5			; Advance LBA (+2)
	DEC	R6
	JNE	WT_SEC
	JMP	WT_LOOP
WT_DONE:
	RET

;====================================================================
; BOOTLOADER (Loaded to 0A00H by BIOS)
;====================================================================
	AORG	LADDRESS
LOADER:
	LWPI	WORKSP
	LI	SP,STACKP
	CALL	@IDE_READY

	LI	R5,DIR_LBA
	LI	R3,IOBUF
	CALL	@READ_SECTOR
	JLT	LOADERR

	LI	R8,IOBUF
	LI	R4,SHELL
	CALL	@MATCH
	JNE	LOADERR
	CALL	@LOADSYS

	AI	R8,32
	LI	R4,BDOS
	CALL	@MATCH
	JNE	LOADERR
	CALL	@LOADSYS

	B	@SHELL_ADDR

LOADSYS:
	CLR	@CRN(R8)
LOAD1:	MOV	@CRN(R8),R3
	MOV	@FSB(R8),R5
	SLA	R5,3
	A	R3,R5
	SLA	R5,1

	MOV	@FLA(R8),R3
	CALL	@READ_SECTOR
	JNE	LOADERR

	INC	@CRN(R8)
	LI	R0,BYTSEC
	A	R0,@FLA(R8)
	DEC	@FSZ(R8)
	JNE	LOAD1
	RET

MATCH:
	MOV	R8,R3
	SETO	R1
	LI	R0,NAMSIZ
MATCH1:	CB	*R4+,*R3+
	JNE	MATCH2
	DEC	R0
	JNE	MATCH1
	CLR	R1
MATCH2:	MOV	R1,R1
	RET

LOADERR: MESG	@LDMSG
	BLWP	@MONITOR

;=====================================================================
; IDE HARDWARE
;=====================================================================
IDE_BASE_PORT	EQU	8040H
BYTEWIDE	EQU	2
IDE_COMMAND	EQU	IDE_BASE_PORT+7*2
IDE_STATUS	EQU	IDE_BASE_PORT+7*2
IDE_DATA	EQU	IDE_BASE_PORT
IDE_HEAD	EQU	IDE_BASE_PORT+6*2
IDE_CYL_LSB	EQU	IDE_BASE_PORT+4*2
IDE_CYL_MSB	EQU	IDE_BASE_PORT+5*2
IDE_SECTOR	EQU	IDE_BASE_PORT+3*2
IDE_SEC_CNT	EQU	IDE_BASE_PORT+2*2
IDE_ERROR	EQU	IDE_BASE_PORT+1*2

IDE_CMD_READ	EQU	02000H
IDE_CMD_WRITE	EQU	03000H

IDE_READY:
	LI	PORT, IDE_HEAD
	LI	R1, 11100000B*256
	LDCR	R1,BYTEWIDE

	LI	PORT,IDE_COMMAND
BSY1:	STCR	R1,BYTEWIDE
	ANDI	R1,10000000B*256
	JNE	BSY1

	LI	PORT,IDE_COMMAND
RDY1:	STCR	R1,BYTEWIDE
	ANDI	R1,01000000B*256
	JEQ	RDY1
	RET

IDE_GET_ERROR:
	LI	PORT, IDE_ERROR
	CLR	R1
	STCR	R1,BYTEWIDE
	MOVB	R1,R1
	JEQ	IGE_X
	MESG	@IDE_MSG1
	WHEX	R1
IGE_X	RET

IDE_MSG1:	TEXT	"IDE ERROR: "
	WORD	0DH,0AH,0
	EVEN

READ_SECTOR:
	MOV	R3,@BUFPTR
	CALL	@IDE_NOT_BUSY
	CALL	@IDE_WR_LBA
	LI	PORT, IDE_COMMAND
	LI	R1, IDE_CMD_READ
	LDCR	R1,BYTEWIDE
	CALL	@IDE_WAIT_DRQ
	JEQ	IDE_GET_ERROR
	CALL	@IDE_READ_DATA
	RET

WRITE_SECTOR:
	MOV	R3,@BUFPTR
	CALL	@IDE_NOT_BUSY
	CALL	@IDE_WR_LBA
	LI	PORT, IDE_COMMAND
	LI	R1, IDE_CMD_WRITE
	LDCR	R1,BYTEWIDE
	CALL	@IDE_WAIT_DRQ
	CALL	@IDE_WRITE_DATA
	RET

IDE_NOT_BUSY:
	LI	PORT,IDE_COMMAND
BSY2:	STCR	R1,BYTEWIDE
	ANDI	R1,10000000B*256
	JNE	BSY2
	RET

IDE_WAIT_DRQ:
	SETO	R0
	LI	PORT, IDE_COMMAND
	CLR	R1
DRQ1:	DEC	R0
	JEQ	DRQ_X
	STCR	R1,BYTEWIDE
	ANDI	R1,00001000B*256
	JEQ	DRQ1
DRQ_X:	RET

IDE_READ_DATA:
	MOV	@BUFPTR,R4
	LI	R0,512
	LI	PORT,IDE_DATA
RL11:	STCR	R1,BYTEWIDE
	MOVB	R1,*R4+
	DEC	R0
	JNE	RL11
	RET

IDE_WRITE_DATA:
	MOV	@BUFPTR,R4
	LI	R0,512
	LI	PORT,IDE_DATA
WL11:	MOVB	*R4+,R1
	LDCR	R1,BYTEWIDE
	DEC	R0
	JNE	WL11
	RET

IDE_WR_LBA:
	CLR	@LBA
	CLR	@LBA+2
	MOV	R5,@LBA+2

	MOVB	@LBA+0,R1
	ANDI	R1,0FH*256
	ORI	R1,0E0H*256
	LI	PORT,IDE_HEAD
	LDCR	R1,BYTEWIDE

	MOVB	@LBA+1,R1
	LI	PORT,IDE_CYL_MSB
	LDCR	R1,BYTEWIDE

	MOVB	@LBA+2,R1
	LI	PORT,IDE_CYL_LSB
	LDCR	R1,BYTEWIDE

	MOVB	@LBA+3,R1
	LI	PORT,IDE_SECTOR
	LDCR	R1,BYTEWIDE

	LI	R1,2*IDE_BYTSEC
	LI	PORT,IDE_SEC_CNT
	LDCR	R1,BYTEWIDE
	RET

SHELL	TEXT	'SHELL   SYS'
BDOS	TEXT	'BDOS    SYS'
LDMSG	BYTE	0DH,0AH,
	TEXT 	"Boot-no system files..."
	BYTE	0DH,0AH,00
	EVEN

	AORG	LOADER + 510
	WORD	LOADER
SIZE:	EQU	$-LOADER
	BSS	512-SIZE

BUFPTR	WORD	0
LBA:	BSS	4
IOBUF	BSS	BYTSEC

	END
