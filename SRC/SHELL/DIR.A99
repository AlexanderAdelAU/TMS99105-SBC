;===================================================================
; DIR.A99 - shell internal command DIR                  (shell 6.5)
;
; Assembled on its own at AORG 0D000H and loaded at cold start into
; its own physical page of segment D (page 2).  Runs with PSEL on.
;
; Rules for every command page:
;   - exit by branching into the core - RETURN, NEXTCMD or an error
;     exit; never return, never call another command
;   - never execute PSEL_DIS, never remap segment D
;   - the BDOS is reached through the gate: CORE.INC equates BDOS to it,
;     so DECLS.INC must never declare BDOS
;   - the first instruction must be B @entry: LDCMDS checks for it
;   - anything up to 4096 bytes fits; the page is this command's alone
;===================================================================
	INCL	"C:DECLS.INC"	; registers, XOPs, EQUs (hand-maintained)[cite: 1]
	INCL	"C:CORE.INC"	; core addresses (generated by MKCINC)[cite: 1]
	AORG	0D000H			;[cite: 1]
	B	@DSKDIR		; entry: every command page starts here[cite: 1]

DSKDIR:	CLR	R0			;[cite: 1]
	MOV	R0,@CCOUNT		;[cite: 1]

	; --- FULLY INITIALIZE FCB FOR SAFE DIRECTORY SEARCH ---
	LI	R4,FCB			;[cite: 1]
	CLR	@CRN(R4)		; Clear Current Record Number[cite: 1]
	CLR	@CBN(R4)		; Clear Current Block Number[cite: 1]

	; Clear bytes 12 through 35 of FCB to prevent stale pointers
	LI	R2,12			;[cite: 1]
	LI	R5,FCB+12		;[cite: 1]
DSK_CLR: CLR	*R5+			;[cite: 1]
	DECT	R2			;[cite: 1]
	JNE	DSK_CLR			;[cite: 1]

	; --- TELL BDOS TO USE THE ACTIVE FOLDER ---
	MOVB	@SPACE,@FCB+18		; Blank target byte = Use CFLD[cite: 1]

	; --- PRE-FILL FCB WITH SPACES ---
	LI	R8,FCB			;[cite: 1]
	LI	R0,NAMSIZ		; NAMSIZ is 11[cite: 1]
	MOV	R8,R2			;[cite: 1]
CLR_FCB	LI	R1,2000H		; Load ' ' (Space) into high byte
	MOVB	R1,*R2+
	DEC	R0			;[cite: 1]
	JNE	CLR_FCB			;[cite: 1]

	; --- SKIP LEADING SPACES ---
SKIP_SP	CLR	R1
	MOVB	*R3+,R1			; Fetch character from R3 command tail[cite: 2]
	CI	R1,2000H		; Compare against ' ' (Space)
	JEQ	SKIP_SP
	DEC	R3			; Backtrack to the first non-space character

	; --- CHECK FOR EMPTY ARGUMENT (DEFAULT TO *.*) ---
	CLR	R1
	MOVB	*R3,R1
	CI	R1,0D00H		; Compare against CR terminator[cite: 2]
	JEQ	SET_ALL			; If CR, default to all files
	MOV	R1,R1
	JEQ	SET_ALL			; If null, default to all files

	; --- PARSE FILENAME (UP TO 8 CHARS) ---
	LI	R4,8			; Max 8 chars for name
PARSE_N	CLR	R1
	MOVB	*R3+,R1			; Get next char, advance pointer
	CI	R1,0D00H		; Stop on CR[cite: 2]
	JEQ	DONE_PR
	MOV	R1,R1			; Stop on Null
	JEQ	DONE_PR
	CI	R1,2000H		; Stop on Space
	JEQ	DONE_PR
	CI	R1,2E00H		; Switch to extension on '.' (Dot)
	JEQ	PARSE_E
	CI	R1,2A00H		; Fill remainder with wildcards on '*' (Star)
	JEQ	WILD_N

	MOVB	R1,*R8+			; Write literal character to FCB
	DEC	R4
	JNE	PARSE_N

	; Name exceeds 8 chars: skip remaining characters until dot or end
SKIP_N	CLR	R1
	MOVB	*R3+,R1
	CI	R1,0D00H		;[cite: 2]
	JEQ	DONE_PR
	MOV	R1,R1
	JEQ	DONE_PR
	CI	R1,2E00H		; Jump to extension parsing on '.' (Dot)
	JEQ	PARSE_E
	JMP	SKIP_N

	; Fill remainder of the filename field with '?'
WILD_N	LI	R1,3F00H		; Load '?' (Question Mark) into high byte
	MOVB	R1,*R8+
	DEC	R4
	JNE	WILD_N
	JMP	SKIP_N			; Continue scanning string for extension

	; --- PARSE EXTENSION (UP TO 3 CHARS) ---
PARSE_E	LI	R8,FCB+8		; Point directly to FCB extension field
	LI	R4,3			; Max 3 chars for extension
PARSE_E1 CLR	R1
	MOVB	*R3+,R1
	CI	R1,0D00H		;[cite: 2]
	JEQ	DONE_PR
	MOV	R1,R1
	JEQ	DONE_PR
	CI	R1,2000H		; Stop on Space
	JEQ	DONE_PR
	CI	R1,2A00H		; Fill remainder with wildcards on '*' (Star)
	JEQ	WILD_E

	MOVB	R1,*R8+			; Write literal character to FCB
	DEC	R4
	JNE	PARSE_E1
	JMP	DONE_PR

	; Fill remainder of the extension field with '?'
WILD_E	LI	R1,3F00H		; Load '?' (Question Mark) into high byte
	MOVB	R1,*R8+
	DEC	R4
	JNE	WILD_E
	JMP	DONE_PR

	; --- DEFAULT ALL WILDCARDS (NO ARGUMENT PASSED) ---
SET_ALL	LI	R8,FCB			;[cite: 1]
	LI	R0,NAMSIZ		;[cite: 1]
	MOV	R8,R2			;[cite: 1]
	LI	R1,3F00H		; Load '?' (Question Mark) into high byte
ALL_LP	MOVB	R1,*R2+
	DEC	R0			;[cite: 1]
	JNE	ALL_LP			;[cite: 1]

DONE_PR
	; --- PARSING COMPLETE ---
	; BDOS automatically filters SEARCH1 using its internal active CFLD
	LI	R2,SEARCH1		;[cite: 1]
	LI	R3,FCB			;[cite: 1]
	CALL	@BDOS			;[cite: 1]
	MOV	R1,R1			;[cite: 1]
	JLT	NOFILE			;[cite: 1]
	CALL	@PNAME			;[cite: 1]
DSKDIR1	LI	R2,SEARCH2		;[cite: 1]
	LI	R3,FCB			;[cite: 1]
	CALL	@BDOS			;[cite: 1]
	MOV	R1,R1			;[cite: 1]
	JLT	DIREXIT			;[cite: 1]
	CALL	@PNAME			;[cite: 1]
	JMP	DSKDIR1			;[cite: 1]

PNAME	MOV	R3,R1			;[cite: 1]
	LI	R0,NAMSIZ		;[cite: 1]
PNAME2	DECT	SP			;[cite: 1]
	MOV	R0,*SP			;[cite: 1]
	MOVB	*R1+,R3			;[cite: 1]
	SWPB	R3			;[cite: 1]
	DECT	SP			;[cite: 1]
	MOV	R1,*SP			;[cite: 1]
	LI	R2,COUT			;[cite: 1]
	CALL	@BDOS			;[cite: 1]
	MOV	*SP+,R1			;[cite: 1]
	MOV	*SP+,R0			;[cite: 1]
	DEC	R0			;[cite: 1]
	JNE	PNAME2			;[cite: 1]
	INC	@CCOUNT			;[cite: 1]
	MOV	@CCOUNT,R0		;[cite: 1]
	CI	R0,DIRCOLS		;[cite: 1]
	JLT	PNAMESP			;[cite: 1]
	CLR	R0			;[cite: 1]
	MOV	R0,@CCOUNT		;[cite: 1]
	MESG	@CRLF			;[cite: 1]
	JMP	PNAME3			;[cite: 1]
PNAMESP	MESG	@SEP			;[cite: 1]
PNAME3	RET				;[cite: 1]

DIREXIT	MESG	@CRLF			;[cite: 1]
	CLR	R1			;[cite: 1]
	B	@RETURN			;[cite: 1]
NOFILE	MESG	@MNOFILE		;[cite: 1]
	CLR	R1			;[cite: 1]
	B	@RETURN			;[cite: 1]

	END				;[cite: 1]
