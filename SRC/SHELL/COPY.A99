;===================================================================
; COPY.A99 - shell internal command COPY                  (shell 6.5)
;
;   COPY <src> <dst>          e.g.  COPY [TOOLS]ABC.EXE DEF.COM
;
; Copies one file.  Either name may carry a [FOLDER] prefix; a name
; without one is in the shell's current folder.  The copy keeps the
; source's load address (FLA), type byte (FTY) and last-record length
; (LRBL), so a copied .COM still loads where it should.
;
; Refuses, as ERA/SAVE/REN do:
;   - wildcards ('?' is a real wildcard in the BDOS directory search)
;   - a .SYS or .SHC destination (system files)
;   - a file copied onto itself (ERAFIL would free the source's blocks
;     before a sector of it was read)
; A write or close failure erases the partial destination.
;
; Folders: the BDOS resolves an FCB's folder when it is CALLED - byte 18
; >20 means "the active folder" - so each file is handled with its own
; folder active.  The source is opened in its folder; after that, reads
; follow its block chain.  The destination is checked, erased, made,
; written and closed in ITS folder: a root file's folder id is 0, which
; the BDOS also reads as "the active folder", so the destination's folder
; must still be active at FCLOSE.  The shell's folder is restored on
; every exit.
;
; Everything the BDOS touches (FCBs, folder names, the sector buffer)
; is in common memory below >C000: BGATE runs the BDOS with PSEL off.
; Nothing is kept in registers across a BDOS call - FCHDIR alone
; changes R0-R8.
;
; Registered in the core's ICLIST as "COPY", page 11, entry >D000.
;===================================================================
	INCL	"C:DECLS.INC"		; registers, XOPs, EQUs
	INCL	"C:CORE.INC"		; core addresses (generated by MKCINC)
	AORG	0D000H
	B	@COPYCMD		; entry: every command page starts here

;-------------------------------------------------------------------
; Common memory used by COPY (below >C000, visible with PSEL off)
;   >0280-02A3  COMM_FCB           source FCB
;   >02A4-02C7  COPY_DFCB          destination FCB  \  the shell's unused
;   >02C8-02D3  COPY_SFLD          source folder     > OVL_PAGE_TAB and
;   >02D4-02DF  COPY_DFLD          destination folder/ OVL_SEG_TAB area
;   >0300-04FF  COMM_BUF           one 512-byte sector
; (>02E4-02E7, OVL_CURR_ID/SEG, are used by the core and left alone.)
;-------------------------------------------------------------------
COPY_SFCB:	EQU	COMM_FCB	; >0280
COPY_DFCB:	EQU	02A4H
COPY_SFLD:	EQU	02C8H		; 11-byte folder name (12 reserved)
COPY_DFLD:	EQU	02D4H		; 11-byte folder name (12 reserved)
COPY_BUF:	EQU	COMM_BUF	; >0300

; FCB fields (BDOS61)
CF_EXT:		EQU	8		; 8-10 extension
CF_FTY:		EQU	11		; type byte
CF_FSB:		EQU	12		; first block
CF_FLA:		EQU	16		; load address
CF_FLD:		EQU	18		; folder id (>20 = active folder)
CF_LRBL:	EQU	20		; bytes in last record

;===================================================================
; COPYCMD
;===================================================================
COPYCMD:
	; --- 1. Parse both names; no BDOS call until both are known ---
	LI	R3,CMDLINE		; step over the command word itself
CP_W:	MOVB	*R3+,R1
	CB	R1,@C_SPC
	JH	CP_W
	DEC	R3			; R3: space or CR after "COPY"

	LI	R8,COPY_SFCB
	LI	R9,COPY_SFLD
	CALL	@PARSARG
	MOV	R0,R0
	JNE	$+6
	B	@CP_SYN			; (too far for a short jump)
	CI	R0,2
	JNE	$+6
	B	@CP_WLD

	LI	R8,COPY_DFCB
	LI	R9,COPY_DFLD
	CALL	@PARSARG
	MOV	R0,R0
	JEQ	CP_SYN
	CI	R0,2
	JEQ	CP_WLD

	; --- 2. Never create a system file ---
	LI	R1,COPY_DFCB+CF_EXT
	LI	R2,EXT_SYS
	CALL	@EXTIS
	MOV	R0,R0
	JNE	CP_SYS
	LI	R1,COPY_DFCB+CF_EXT
	LI	R2,EXT_SHC
	CALL	@EXTIS
	MOV	R0,R0
	JNE	CP_SYS

	; --- 3. Open the source in its folder ---
	LI	R2,FCHDIR
	LI	R3,COPY_SFLD
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_BDR
	LI	R2,FOPEN
	LI	R3,COPY_SFCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_NSR

	; --- 4. Everything else happens in the destination's folder ---
	LI	R2,FCHDIR
	LI	R3,COPY_DFLD
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_BDR

	; --- 5. Not onto itself: same first block = same file ---
	LI	R2,FOPEN
	LI	R3,COPY_DFCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_NEW			; no such destination yet
	C	@COPY_SFCB+CF_FSB,@COPY_DFCB+CF_FSB
	JEQ	CP_SAM
CP_NEW:
	LI	R2,ERAFIL		; replace an existing destination
	LI	R3,COPY_DFCB
	CALL	@BDOS
	LI	R2,MAKFIL
	LI	R3,COPY_DFCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_NDS

	; --- 6. Copy sector by sector ---
	LI	R2,SETDMA
	LI	R3,COPY_BUF
	CALL	@BDOS
CP_LP:	LI	R2,RDSEQ
	LI	R3,COPY_SFCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_EOF			; -1: past the last record
	LI	R2,WRSEQ
	LI	R3,COPY_DFCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_WRE
	JMP	CP_LP

	; --- 7. Keep the source's metadata; close in the dest folder ---
CP_EOF:	MOVB	@COPY_SFCB+CF_FTY,@COPY_DFCB+CF_FTY
	MOV	@COPY_SFCB+CF_FLA,@COPY_DFCB+CF_FLA
	MOV	@COPY_SFCB+CF_LRBL,@COPY_DFCB+CF_LRBL
	LI	R2,FCLOSE
	LI	R3,COPY_DFCB
	CALL	@BDOS
	MOV	R1,R1
	JLT	CP_WRE
	LI	R1,MSG_OK
	JMP	CP_EXIT

;-------------------------------------------------------------------
; Exits.  R1 = message.  Every exit restores the shell's folder.
;-------------------------------------------------------------------
CP_WRE:	LI	R2,FCLOSE		; write/close failed: drop the
	LI	R3,COPY_DFCB		; partial destination (its folder
	CALL	@BDOS			; is still the active one)
	LI	R2,ERAFIL
	LI	R3,COPY_DFCB
	CALL	@BDOS
	LI	R1,MSG_WRE
	JMP	CP_EXIT
CP_SYN:	LI	R1,MSG_SYN
	JMP	CP_EXIT
CP_WLD:	LI	R1,MSG_WLD
	JMP	CP_EXIT
CP_SYS:	LI	R1,MSG_SYS
	JMP	CP_EXIT
CP_BDR:	LI	R1,MSG_BDR
	JMP	CP_EXIT
CP_NSR:	LI	R1,MSG_NSR
	JMP	CP_EXIT
CP_SAM:	LI	R1,MSG_SAM
	JMP	CP_EXIT
CP_NDS:	LI	R1,MSG_NDS

CP_EXIT:
	MOV	R1,@PSPTR		; the message survives the BDOS call
	LI	R2,FCHDIR		; back to the shell's folder
	LI	R3,CURDIR
	CALL	@BDOS
	MOV	@PSPTR,R1
	CALL	@PSTR
	CLR	R1
	B	@RETURN

;===================================================================
; PSTR - print a zero-terminated string (in this page) via BDOS COUT
; In: R1 = string.  The pointer is kept in memory across each call.
;===================================================================
PSTR:	MOV	R1,@PSPTR
PS1:	MOV	@PSPTR,R1
	MOVB	*R1,R3
	JEQ	PS2
	INC	@PSPTR
	SWPB	R3			; COUT prints R3's low byte
	LI	R2,COUT
	CALL	@BDOS
	JMP	PS1
PS2:	RET

;===================================================================
; EXTIS - does the 3-byte extension at R1 equal the one at R2?
; Out: R0 = 1 yes, 0 no.  Uses R0-R2 only.
;===================================================================
EXTIS:	CLR	R0
	CB	*R1+,*R2+
	JNE	EX9
	CB	*R1+,*R2+
	JNE	EX9
	CB	*R1,*R2
	JNE	EX9
	INC	R0
EX9:	RET

;===================================================================
; UPC - upper-case the character in R1's high byte.  Uses R1 only.
;===================================================================
UPC:	CB	R1,@C_LA
	JL	UP9
	CB	R1,@C_LZ
	JH	UP9
	AI	R1,-2000H		; 'a'..'z' -> 'A'..'Z'
UP9:	RET

;===================================================================
; PARSARG - parse "[FOLDER]NAME.EXT" into an FCB and a folder name
; In:  R3 = text (leading spaces allowed)
;      R8 = FCB (36 bytes, common memory)
;      R9 = folder-name buffer (11 bytes, common memory)
; Out: R0 = 1 parsed, 0 missing or malformed, 2 wildcard
;      R3 = just past the token
; Makes no BDOS call.  Without a [FOLDER] the buffer gets CURDIR, so
; the caller can always FCHDIR to it.
;===================================================================
PARSARG:
	MOV	R8,R2			; clear the FCB (18 words)
	LI	R4,18
PA_CLR:	CLR	*R2+
	DEC	R4
	JNE	PA_CLR
	MOV	R8,R2			; name and extension: 11 spaces
	LI	R4,11
PA_SP:	MOVB	@C_SPC,*R2+
	DEC	R4
	JNE	PA_SP
	MOVB	@C_SPC,@CF_FLD(R8)	; >20: the active folder

	MOV	R9,R2			; folder: the shell's current one
	LI	R4,CURDIR
	LI	R5,11
PA_CD:	MOVB	*R4+,*R2+
	DEC	R5
	JNE	PA_CD

PA_SKL:	MOVB	*R3+,R1			; skip leading spaces
	CB	R1,@C_SPC
	JEQ	PA_SKL
	DEC	R3
	MOVB	*R3,R1
	CB	R1,@C_SPC		; CR, NUL or nothing: no argument
	JLE	PA_BAD
	CB	R1,@C_LBR
	JNE	PA_NAM

	; --- [FOLDER] ---
	INC	R3			; step over '['
	MOV	R9,R2			; replace the default with spaces
	LI	R4,11
PA_FS:	MOVB	@C_SPC,*R2+
	DEC	R4
	JNE	PA_FS
	MOV	R9,R2
	LI	R4,11			; at most 11 characters kept
PA_FL:	MOVB	*R3+,R1
	CB	R1,@C_RBR
	JEQ	PA_NAM
	CB	R1,@C_SPC		; CR, NUL or space before ']'
	JLE	PA_BAD
	MOV	R4,R4			; beyond 11 characters: ignore
	JEQ	PA_FL
	CALL	@UPC
	MOVB	R1,*R2+
	DEC	R4
	JMP	PA_FL

	; --- NAME[.EXT] ---
PA_NAM:	MOVB	*R3,R1			; a name must follow
	CB	R1,@C_SPC
	JLE	PA_BAD
	MOV	R8,R2
	LI	R4,8			; up to 8 name characters
PA_NL:	MOVB	*R3,R1
	CB	R1,@C_SPC		; space, CR, NUL: done
	JLE	PA_OK
	INC	R3
	CB	R1,@C_DOT
	JEQ	PA_EXT
	CB	R1,@C_QM
	JEQ	PA_WLD
	CB	R1,@C_AST
	JEQ	PA_WLD
	MOV	R4,R4			; beyond 8 characters: ignore
	JEQ	PA_NL
	CALL	@UPC
	MOVB	R1,*R2+
	DEC	R4
	JMP	PA_NL

PA_EXT:	MOV	R8,R2
	AI	R2,CF_EXT
	LI	R4,3			; up to 3 extension characters
PA_EL:	MOVB	*R3,R1
	CB	R1,@C_SPC
	JLE	PA_OK
	INC	R3
	CB	R1,@C_QM
	JEQ	PA_WLD
	CB	R1,@C_AST
	JEQ	PA_WLD
	MOV	R4,R4
	JEQ	PA_EL
	CALL	@UPC
	MOVB	R1,*R2+
	DEC	R4
	JMP	PA_EL

PA_OK:	LI	R0,1
	RET
PA_BAD:	CLR	R0
	RET
PA_WLD:	LI	R0,2
	RET

;===================================================================
; Data (in this page)
;===================================================================
PSPTR:	WORD	0

C_SPC:	BYTE	' '
C_DOT:	BYTE	'.'
C_QM:	BYTE	'?'
C_AST:	BYTE	'*'
C_LBR:	BYTE	'['
C_RBR:	BYTE	']'
C_LA:	BYTE	'a'
C_LZ:	BYTE	'z'
EXT_SYS:	TEXT	'SYS'
EXT_SHC:	TEXT	'SHC'

MSG_OK:	TEXT	'1 File(s) copied'
	BYTE	0DH,0AH,0
MSG_SYN:	TEXT	'--Syntax: COPY <src> <dst>'
	BYTE	0DH,0AH,0
MSG_WLD:	TEXT	'--COPY needs exact file names, no wildcards'
	BYTE	0DH,0AH,0
MSG_SYS:	TEXT	'--System files (.SYS .SHC) are protected: not copied over'
	BYTE	0DH,0AH,0
MSG_BDR:	TEXT	'--Folder not found'
	BYTE	0DH,0AH,0
MSG_NSR:	TEXT	'--Source file not found'
	BYTE	0DH,0AH,0
MSG_SAM:	TEXT	'--A file cannot be copied onto itself'
	BYTE	0DH,0AH,0
MSG_NDS:	TEXT	'--Cannot create destination'
	BYTE	0DH,0AH,0
MSG_WRE:	TEXT	'--Write error: destination removed'
	BYTE	0DH,0AH,0
	EVEN

	END
