                        ;*******************************************************************
                        ;   PAGEDUMP.A99 - Dump memory from any physical page
                        ;   TMS99105 SBC V4
                        ;   Load at 0x1000
                        ;
                        ;   Parameters at fixed addresses (set before running):
                        ;     0x1000: Entry point (B @_main)
                        ;     0x1002: Page number   (0-15, default 0)
                        ;     0x1004: Segment number (0-15, default 2)
                        ;     0x1006: NumWords      (number of words to dump, default 64)
                        ;
                        ;   Usage:
                        ;     Load utility at 0x1000
                        ;     Modify parameters as needed, e.g:
                        ;       E 1002 0001    set page 1
                        ;       E 1004 0003    set segment 3 (address 0x3000)
                        ;       E 1006 0020    dump 32 words
                        ;     Then: 1000G
                        ;
                        ;   Output format:
                        ;     PAGE:xx SEG:xx ADDR:xxxx
                        ;     xxxx: xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx
                        ;     xxxx: xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx
                        ;     ...
                        ;*******************************************************************
                        
                                DXOP    WHEX,10
                                DXOP    MESG,14
                        
  0000                  R0      EQU     0
  0001                  R1      EQU     1
  0002                  R2      EQU     2
  0003                  R3      EQU     3
  0004                  R4      EQU     4
  0005                  R5      EQU     5
  0009                  R9      EQU     9
  000B                  R11     EQU     11
                        
  E800                  MAP_WIN_BASE    EQU     0E800H
  0010                  NUM_MAP_ENTRIES EQU     16
  0008                  WORDS_PER_LINE  EQU     8
                        
  1000                          AORG    1000H
                        
                        ;--- Entry point ---
  1000   0460 100E              B       @_main
                        
                        ;--- Parameters (user modifies these before running) ---
  1004   0000           PRM_PAGE:   WORD    0               ; page number (0-15)
  1006   0002           PRM_SEG:    WORD    2               ; segment number (0-15)
  1008   0040           PRM_WORDS:  WORD    64              ; number of words to dump
                        
  100A   02E0 0250              LWPI    0250H
                        
                        _main::
                        
                        ;--- Save current map registers ---
  100E   06A0 10A8              BL      @MAP_INIT
                        
                        ;--- Map requested segment to requested page ---
  1012   C260 1006              MOV     @PRM_SEG, R9
  1016   C020 1004              MOV     @PRM_PAGE, R0
  101A   06A0 10BC              BL      @MAP_SET
                        
                        ;--- Print header ---
  101E   2FA0 10CC              MESG    @TXT_PAGE
  1022   C020 1004              MOV     @PRM_PAGE, R0
  1026   2E80                   WHEX    R0
                        
  1028   2FA0 10D2              MESG    @TXT_SEG
  102C   C020 1006              MOV     @PRM_SEG, R0
  1030   2E80                   WHEX    R0
                        
                        ;--- Calculate base address: segment * 4096 ---
  1032   C0E0 1006              MOV     @PRM_SEG, R3
  1036   0AC3                   SLA     R3, 12              ; segment * 0x1000
  1038   C803 10C8              MOV     R3, @BASEADDR
                        
  103C   2FA0 10D8              MESG    @TXT_ADDR
  1040   2E83                   WHEX    R3
  1042   2FA0 10E6              MESG    @TXT_NL
                        
                        ;--- Dump loop ---
  1046   C120 1008              MOV     @PRM_WORDS, R4      ; word count
  104A   C160 10C8              MOV     @BASEADDR, R5       ; current address
  104E   04E0 10CA              CLR     @LINECNT
                        
                        DUMPLOOP:
                        ;--- Print address at start of each line ---
  1052   C020 10CA              MOV     @LINECNT, R0
  1056   0280 0000              CI      R0, 0
  105A   1605                   JNE     NOTFIRST
  105C   2FA0 10E0              MESG    @TXT_INDENT
  1060   2E85                   WHEX    R5
  1062   2FA0 10E2              MESG    @TXT_COLON
                        NOTFIRST:
                        
                        ;--- Print word ---
  1066   C035                   MOV     *R5+, R0
  1068   2FA0 10E4              MESG    @TXT_SPACE
  106C   2E80                   WHEX    R0
                        
                        ;--- Check end of line ---
  106E   05A0 10CA              INC     @LINECNT
  1072   C020 10CA              MOV     @LINECNT, R0
  1076   0280 0008              CI      R0, WORDS_PER_LINE
  107A   1609                   JNE     NOTEND
  107C   2FA0 10E6              MESG    @TXT_NL
  1080   04E0 10CA              CLR     @LINECNT
  1084   2FA0 10E0              MESG    @TXT_INDENT
  1088   2E85                   WHEX    R5
  108A   2FA0 10E2              MESG    @TXT_COLON
                        NOTEND:
                        
  108E   0604                   DEC     R4
  1090   16E0                   JNE     DUMPLOOP
                        
                        ;--- Final newline if mid-line ---
  1092   C020 10CA              MOV     @LINECNT, R0
  1096   0280 0000              CI      R0, 0
  109A   1302                   JEQ     DONE
  109C   2FA0 10E6              MESG    @TXT_NL
                        
                        DONE:
                        ;--- Restore all map registers to page 0 ---
  10A0   06A0 10A8              BL      @MAP_INIT
  10A4   0420 F004              BLWP    @0F004H
                        
                        ;*******************************************************************
                        ; MAP_INIT - clear all 16 entries to page 0
                        ;*******************************************************************
                        MAP_INIT:
  10A8   0209 E800              LI      R9, MAP_WIN_BASE
  10AC   04C0                   CLR     R0
  10AE   0201 0010              LI      R1, NUM_MAP_ENTRIES
  10B2   C640           MAPI_L: MOV     R0, *R9
  10B4   05C9                   INCT    R9
  10B6   0601                   DEC     R1
  10B8   16FC                   JNE     MAPI_L
  10BA   045B                   RT
                        
                        ;*******************************************************************
                        ; MAP_SET - R9=segment, R0=page
                        ;*******************************************************************
                        MAP_SET:
  10BC   0A19                   SLA     R9, 1
  10BE   0229 E800              AI      R9, MAP_WIN_BASE
  10C2   0A80                   SLA     R0, 8
  10C4   C640                   MOV     R0, *R9
  10C6   045B                   RT
                        
                        ;*******************************************************************
                        ; Storage
                        ;*******************************************************************
  10C8   0000           BASEADDR:   WORD    0
  10CA   0000           LINECNT:    WORD    0
                        
                        ;*******************************************************************
                        ; Messages
                        ;*******************************************************************
  10CC   5041 4745      TXT_PAGE:   TEXT    "PAGE:"
  10D0   3A             
  10D1   00                         BYTE    0
  10D2                              EVEN
  10D2   2053 4547      TXT_SEG:    TEXT    " SEG:"
  10D6   3A             
  10D7   00                         BYTE    0
  10D8                              EVEN
  10D8   2041 4444      TXT_ADDR:   TEXT    " ADDR:"
  10DC   523A           
  10DE   00                         BYTE    0
  10DF   00                         EVEN
  10E0   00             TXT_INDENT: BYTE    0
  10E1   00                         EVEN
  10E2   3A             TXT_COLON:  TEXT    ":"
  10E3   00                         BYTE    0
  10E4                              EVEN
  10E4   20             TXT_SPACE:  TEXT    " "
  10E5   00                         BYTE    0
  10E6                              EVEN
  10E6   0D0A 00        TXT_NL:     BYTE    0DH,0AH,0
  10E9   00                         EVEN
                        
  10EA                          END

No error(s).
DONE             10A0  TXT_SPACE        10E4  MAP_WIN_BASE     E800  TXT_NL           10E6  
TXT_PAGE         10CC  MAP_INIT         10A8  R0               0000  WHEX             2E80  
R2               0002  PRM_PAGE         1004  R4               0004  DUMPLOOP         1052  
R9               0009  WORDS_PER_LINE   0008  TXT_COLON        10E2  NUM_MAP_ENTRIES  0010  
MAP_SET          10BC  MAPI_L           10B2  PRM_WORDS        1008  _main            100E  
R1               0001  LINECNT          10CA  R5               0005  NOTEND           108E  
MESG             2F80  TXT_INDENT       10E0  BASEADDR         10C8  R11              000B  
R3               0003  TXT_SEG          10D2  TXT_ADDR         10D8  NOTFIRST         1066  
PRM_SEG          1006  
