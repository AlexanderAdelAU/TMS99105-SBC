;*******************************************************************
;	MAPDEBUG.A99 - Paged Memory Mapper Debug Utility
;	TMS99105 SBC V4
;	Load at 0x0500 (COMMON)
;
;	Parameters at fixed addresses - edit then run 500G:
;
;	0502: COMMAND
;	0504: SEG_PAGE   HIGH BYTE=PAGE(0-15)  LOW BYTE=SEG(0-15)
;	0506: VALUE      value to write (CMD 5) / dump offset (CMD 10) / SRC SEG:PAGE (CMD 11)
;	0508: OFFSET     byte offset into the segment (CMD 5/6 only,
;	                 0-0FFFH). Target address = (SEG*0x1000) + OFFSET.
;	                 Leave 0 to address the segment's own base, same
;	                 as before this existed. Ignored by every other
;	                 command - only WPGSEG/RPGSEG use it.
;	                 MASKED to 0-0FFFH before use - if you accidentally
;	                 type a full address here (e.g. 3A22 instead of
;	                 just A22), only the low 12 bits are kept, so it
;	                 can never spill into a different segment. The
;	                 command's output shows both the raw OFFS you
;	                 entered and the final masked ADDR actually used.
;
;	COMMANDS:
;	1=PSEN  2=PSDIS  3=SMREG  4=RMREG  5=WPGSEG  6=RPGSEG
;	7=CLR   8=LST    9=RDLP   A=PGLP   B=HLP     C=SETALL
;	D=SCYC  E=INIT   F=CODE   10=DUMP  11=COPY
;*******************************************************************

	DXOP	WRITE,12	;OUTPUT CHAR IN MSB
	DXOP	WHEX,10
	DXOP	MESG,14
	DXOP	PSEL_EN,1
	DXOP	PSEL_DIS,0
;	PSEL CONTROL IS VIA XOP 1/0 ONLY - NO PARAMETERIZED PSEL XOP

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R9	EQU	9
R10	EQU	10
R11	EQU	11
R12	EQU	12
R15	EQU	15
MAP_PORT	EQU	R12

MAP_BASE_PORT	EQU	80C0H
BYTEWIDE	EQU	2


CMD_PSEL_EN	EQU	1
CMD_PSEL_DIS	EQU	2
CMD_MAPREG_WR	EQU	3
CMD_MAPREG_RD	EQU	4
CMD_SEG_WR	EQU	5
CMD_SEG_RD	EQU	6
CMD_MAP_CLR	EQU	7
CMD_MAP_LST	EQU	8
CMD_RDLOOP	EQU	9
CMD_PGLOOP	EQU	10
CMD_HELP	EQU	11
CMD_SEGLOOP	EQU	12
CMD_SEGCYC	EQU	13
CMD_INIT	EQU	14
CMD_CODETEST	EQU	15
CMD_DUMP	EQU	16		;DUMP 64 BYTES FROM PAGED SEGMENT
CMD_COPY	EQU	17		;COPY SRC SEG:PAGE TO DST SEG:PAGE
CMD_GO		EQU	18		;PROGRAM SEG:PAGE AND JUMP TO IT

	AORG	0500H

	JMP	START

;--- Parameters at fixed addresses ---
COMMAND:	WORD	CMD_MAPREG_WR	;0502: COMMAND
SEG_PAGE:	WORD	0102H		;0504: HIGH=PAGE LOW=SEG
VALUE:		WORD	0A5A5H		;0506: WRITE VALUE / COPY SOURCE ADDR
OFFSET:		WORD	0000H		;0508: byte offset into segment (CMD 5/6)

START:
	LWPI	0250H
	CLR	MAP_PORT
	PSEL_DIS			;DISABLE PSEL IMMEDIATELY

;--- Print banner ---
	MESG	@TXT_BANNER

;--- Dispatch ---
	MOV	@COMMAND,R0
	CI	R0,CMD_PSEL_EN
	JNE	D2
	B	@DO_PSEL_EN
D2	CI	R0,CMD_PSEL_DIS
	JNE	D3
	B	@DO_PSEL_DIS
D3	CI	R0,CMD_MAPREG_WR
	JNE	D4
	B	@DO_MAPREG_WR
D4	CI	R0,CMD_MAPREG_RD
	JNE	D5
	B	@DO_MAPREG_RD
D5	CI	R0,CMD_SEG_WR
	JNE	D6
	B	@DO_SEG_WR
D6	CI	R0,CMD_SEG_RD
	JNE	D7
	B	@DO_SEG_RD
D7	CI	R0,CMD_MAP_CLR
	JNE	D8
	B	@DO_MAP_CLR
D8	CI	R0,CMD_MAP_LST
	JNE	D9
	B	@DO_MAP_LST
D9	CI	R0,CMD_RDLOOP
	JNE	D10
	B	@DO_RDLOOP
D10	CI	R0,CMD_PGLOOP
	JNE	D11
	B	@DO_PGLOOP
D11	CI	R0,CMD_HELP
	JNE	D12
	B	@DO_HELP
D12	CI	R0,CMD_SEGLOOP
	JNE	D13
	B	@DO_SEGLOOP
D13	CI	R0,CMD_SEGCYC
	JNE	D14
	B	@DO_SEGCYC
D14	CI	R0,CMD_INIT
	JNE	D15
	B	@DO_INIT
D15	CI	R0,CMD_CODETEST
	JNE	D16
	B	@DO_CODETEST
D16	CI	R0,CMD_DUMP
	JNE	D17
	B	@DO_DUMP
D17	CI	R0,CMD_COPY
	JNE	D18
	B	@DO_COPY
D18	CI	R0,CMD_GO
	JNE	DBAD
	B	@DO_GO
DBAD	MESG	@TXT_BADCMD
	B	@EXIT

;--- CMD 1: Enable PSEL ---
DO_PSEL_EN:
	CLR	MAP_PORT
	PSEL_EN
	MESG	@TXT_PSEL_EN
	B	@EXIT

;--- CMD 2: Disable PSEL ---
DO_PSEL_DIS:
	CLR	MAP_PORT
	PSEL_DIS
	MESG	@TXT_PSEL_DIS
	B	@EXIT

;--- CMD 3: Write map register, read back verify ---
DO_MAPREG_WR:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	MOV	R0,R1			;SAVE PAGE
	BL	@MAP_SET

	MESG	@TXT_MWRSEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;PRINT SEGMENT
	MESG	@TXT_PAGE
	WHEX	R1			;PRINT PAGE
	MESG	@TXT_NL

	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH
	BL	@MAP_GET		;R0 = READBACK
	MESG	@TXT_READBACK
	WHEX	R0
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 4: Read map register ---
DO_MAPREG_RD:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	BL	@MAP_GET		;R0 = READBACK FROM 6116
	MESG	@TXT_MRDSEG
	MOV	@SEG_PAGE,R1
	ANDI	R1,00FFH
	WHEX	R1			;SEGMENT
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R1
	SWPB	R1
	ANDI	R1,00FFH
	WHEX	R1			;PAGE
	MESG	@TXT_READBACK
	WHEX	R0			;READBACK FROM 6116
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 5: Write value to segment/page ---
DO_SEG_WR:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	BL	@MAP_SET		;1. CONFIGURE MAP REGISTER
	PSEL_EN			;2. ENABLE PSEL

	BL	@CALC_ADDR		;CALC ADDRESS
	MOV	@OFFSET,R0
	ANDI	R0,0FFFH		;MASK TO VALID IN-SEGMENT RANGE
	A	R0,R2			;ADD OFFSET INTO SEGMENT
	MOV	@VALUE,R1		;LOAD VALUE BEFORE PSEL

	MOV	R1,*R2			;3. WRITE
	PSEL_DIS			;4. DISABLE PSEL
	MESG	@TXT_WPGSEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SEG
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;PAGE
	MESG	@TXT_OFFS
	MOV	@OFFSET,R0
	WHEX	R0			;OFFSET
	MESG	@TXT_ADDR
	BL	@CALC_ADDR
	MOV	@OFFSET,R0
	ANDI	R0,0FFFH		;MASK TO VALID IN-SEGMENT RANGE
	A	R0,R2
	WHEX	R2			;FINAL ADDRESS
	MESG	@TXT_NL
	MESG	@TXT_WROTE
	MOV	@VALUE,R0
	WHEX	R0
	MESG	@TXT_SEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 6: Read from segment/page ---
DO_SEG_RD:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	BL	@MAP_SET		;1. CONFIGURE MAP REGISTER
	BL	@CALC_ADDR		;2. CALC ADDRESS
	MOV	@OFFSET,R0
	ANDI	R0,0FFFH		;MASK TO VALID IN-SEGMENT RANGE
	A	R0,R2			;ADD OFFSET INTO SEGMENT
	PSEL_EN			;3. ENABLE PSEL
	MOV	*R2,R1			;4. READ
	PSEL_DIS			;5. DISABLE PSEL
	MESG	@TXT_RPGSEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SEG
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;PAGE
	MESG	@TXT_OFFS
	MOV	@OFFSET,R0
	WHEX	R0			;OFFSET
	MESG	@TXT_ADDR
	BL	@CALC_ADDR
	MOV	@OFFSET,R0
	ANDI	R0,0FFFH		;MASK TO VALID IN-SEGMENT RANGE
	A	R0,R2
	WHEX	R2			;FINAL ADDRESS
	MESG	@TXT_NL
	MESG	@TXT_READ
	MOV	R1,R0
	WHEX	R0
	MESG	@TXT_SEG
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0
	MESG	@TXT_NL
	B	@EXIT

;--- CMD 7: Clear all map registers to page 0 ---
DO_MAP_CLR:
	LI	MAP_PORT,MAP_BASE_PORT
	CLR	R1
	LI	R2,16
MCLR_L:	LDCR	R1,BYTEWIDE
	INCT	MAP_PORT
	DEC	R2
	JNE	MCLR_L
	MESG	@TXT_MAPCLR
	B	@EXIT

;--- CMD 8: List all map registers ---
DO_MAP_LST:
	CLR	R9
MLST_L:
	MESG	@TXT_SEG
	MOV	R9,R0
	WHEX	R0
	MESG	@TXT_PAGE
	MOV	R9,@MLST_SEG
	BL	@MAP_GET
	MOV	@MLST_SEG,R9
	WHEX	R0
	MESG	@TXT_NL
	INC	R9
	CI	R9,16
	JL	MLST_L
	B	@EXIT

;--- CMD 9: Read loop - continuous read from SEG:PAGE ---
DO_RDLOOP:
	MESG	@TXT_RDLOOP
	MESG	@TXT_NL
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	BL	@MAP_SET
	PSEL_EN
	BL	@CALC_ADDR
RDLP:	MOV	*R2,R1
	JMP	RDLP

;--- CMD A: Page loop - cycle all pages on segment ---
DO_PGLOOP:
	MESG	@TXT_PGLOOP
	MESG	@TXT_NL
	PSEL_EN
	MOV	@SEG_PAGE,R3
	ANDI	R3,00FFH		;R3 = SEGMENT
	MOV	R3,R2
	SWPB	R2
	ANDI	R2,0F000H		;R2 = SEGMENT BASE ADDRESS
PGLP:	CLR	R0
PGLP2:	MOV	R3,R9
	BL	@MAP_SET
	MOV	*R2,R1
	INC	R0
	CI	R0,16
	JL	PGLP2
	JMP	PGLP

;--- CMD B: Help ---
DO_HELP:
	MESG	@TXT_HELP
	B	@EXIT

;--- CMD C: Init seg N=page N for segs 0-14, seg 15=page 0 ---
DO_SEGLOOP:
	MESG	@TXT_SEGLOOP
	MESG	@TXT_NL
	CLR	R9			;START AT SEG 0
SINIT:
	MOV	R9,R0			;PAGE = SEGMENT
	MOV	R9,@MLST_SEG
	BL	@MAP_SET
	MOV	@MLST_SEG,R9
	INC	R9
	CI	R9,15
	JL	SINIT
	LI	R9,15
	CLR	R0
	BL	@MAP_SET
	MESG	@TXT_DONE
	B	@EXIT

;--- CMD D: Segment cycle - PSEL boundaries for scope ---
DO_SEGCYC:
	MESG	@TXT_SEGCYC
	MESG	@TXT_NL
	MOV	@SEG_PAGE,R2
	ANDI	R2,00FFH
	SWPB	R2
	SLA	R2,4
SCYC:
	PSEL_EN
	MOV	*R2+,R1
	PSEL_DIS
	JMP	SCYC

;--- CMD E: Init seg N=page N for segs 0-14, seg 15=page 0 ---
DO_INIT:
	MESG	@TXT_INIT
	MESG	@TXT_NL
	CLR	R9
INITLP:
	MOV	R9,R0
	MOV	R9,@MLST_SEG
	BL	@MAP_SET
	MOV	@MLST_SEG,R9
	INC	R9
	CI	R9,15
	JL	INITLP
	LI	R9,15
	CLR	R0
	BL	@MAP_SET
	MESG	@TXT_DONE
	B	@EXIT

;--- CMD F: Code execution test ---
;    1. Sets seg2=page2, seg3=page3
;    2. Enables PSEL
;    3. Writes 0xBEEF to seg3 (page3) at 0x3000
;    4. Copies TEST_ROUTINE to seg2 (page2) at 0x2000
;    5. Calls routine at 0x2000 (runs in page2)
;    6. Routine reads 0x3000 (page3) and returns in R0
;    7. Verifies R0=BEEF
DO_CODETEST:
	LI	R10, 1000H
;
; GET PRIVILEGE EXCEPTION THROUGH INTERRUPT TWO VECTOR
;
	LI	R0,0AH		;INT VECTOR 2
	LI	R1,INT2		;NEW INT VERCOR LOCATION
	MOV	R1,*R0

	MESG	@TXT_CODETEST
	MESG	@TXT_NL
;--- SET MAP REGISTERS ---
	LI	R9,2
	LI	R0,2
	BL	@MAP_SET		;SEG2=PAGE2
	LI	R9,3
	LI	R0,3
	BL	@MAP_SET		;SEG3=PAGE3
;--- ENABLE PSEL ---
	PSEL_EN
;--- WRITE 0xBEEF TO PAGE3 AT 0x3000 ---
	LI	R2,3000H
	LI	R1,0BEEFH
	MOV	R1,*R2
;--- COPY TEST_ROUTINE TO PAGE2 AT 0x2000 ---
	LI	R1,TEST_ROUTINE		;SOURCE ADDRESS
	LI	R2,2000H		;DESTINATION IN PAGE2
	LI	R3,TEST_REND-TEST_ROUTINE
	SRL	R3,1			;CONVERT TO WORDS
CTCOPY:
	MOV	*R1+,*R2+
	DEC	R3
	JNE	CTCOPY
;--- CALL TEST ROUTINE AT 0x2000 (RUNS IN PAGE2) ---

	LI	R2,2000H
	CLR	R15
	ORI	R15,0087H
	LST	R15
	BL	*R2
;--- DISABLE PSEL ---
	PSEL_DIS
;--- CHECK RESULT ---
	MESG	@TXT_RESULT
	WHEX	R0
	CI	R0,0BEEFH
	JEQ	CTOK
	MESG	@TXT_CTFAIL
	B	@EXIT
CTOK:	MESG	@TXT_CTOK
	MESG	@TXT_NL
	B	@EXIT




EXIT:
	CLR	MAP_PORT
	PSEL_DIS
	BLWP	@0F004H

;*******************************************************************
;	CALC_ADDR - segment base address from SEG_PAGE
;	Exit: R2 = segment * 0x1000
;*******************************************************************
CALC_ADDR:
	MOV	@SEG_PAGE,R2
	ANDI	R2,00FFH
	SWPB	R2
	SLA	R2,4
	RT

;*******************************************************************
;	MAP_SET - R9=segment, R0=page
;*******************************************************************
MAP_SET:
	LI	MAP_PORT,MAP_BASE_PORT
	SLA	R9,1			;SEGMENT * 2 FOR CRU ADDRESS
	A	R9,MAP_PORT
	SLA	R0,8			;PAGE TO HIGH BYTE
	LDCR	R0,BYTEWIDE
	RT

;*******************************************************************
;	MAP_GET - read map register for segment
;	Entry: R9=segment  Exit: R0=page (bit-reversed SA1:SA0)
;*******************************************************************
MAP_GET:
	LI	MAP_PORT,MAP_BASE_PORT
	SLA	R9,1			;SEGMENT * 2
	A	R9,MAP_PORT
	CLR	R0
	STCR	R0,BYTEWIDE		;READ FROM 6116 INTO BITS 15-14
	SRL	R0,8			;SHIFT TO MATCH SLA R0,8 ENCODING
	RT

;*******************************************************************
;	Storage
;*******************************************************************
MLST_SEG:	WORD	0
WVAL:		WORD	0
WADDR:		WORD	0
WRBK:		WORD	0

;*******************************************************************
;	Messages
;*******************************************************************
TXT_BANNER:	TEXT	"MAPDEBUG COMMANDS:"
		BYTE	0DH,0AH
		TEXT	" 1=PSEN"
		BYTE	0DH,0AH
		TEXT	" 2=PSDIS"
		BYTE	0DH,0AH
		TEXT	" 3=SMREG(0504=PG:SEG)"
		BYTE	0DH,0AH
		TEXT	" 4=RMREG(0504=PG:SEG)"
		BYTE	0DH,0AH
		TEXT	" 5=WPGSEG(0504=PG:SEG 0506=VAL 0508=OFFS)"
		BYTE	0DH,0AH
		TEXT	" 6=RPGSEG(0504=PG:SEG 0508=OFFS)"
		BYTE	0DH,0AH
		TEXT	" 7=CLR"
		BYTE	0DH,0AH
		TEXT	" 8=LST"
		BYTE	0DH,0AH
		TEXT	" 9=RDLP(0504=PG:SEG)"
		BYTE	0DH,0AH
		TEXT	" A=PGLP(0504=PG:SEG)"
		BYTE	0DH,0AH
		TEXT	" B=HLP"
		BYTE	0DH,0AH
		TEXT	" C=SETALL"
		BYTE	0DH,0AH
		TEXT	" D=SCYC(0504=PG:SEG)"
		BYTE	0DH,0AH
		TEXT	" E=INIT"
		BYTE	0DH,0AH
		TEXT	" F=CODE"
		BYTE	0DH,0AH
		TEXT	" 10=DUMP(0504=PAGE:SEG 0506=OFFSET)"
		BYTE	0DH,0AH
		TEXT	" 11=COPY(0504=DST PAGE:SEG 0506=SRC PAGE:SEG)"
		BYTE	0DH,0AH
		TEXT	" 12=GO(0504=PAGE:SEG)"
		BYTE	0DH,0AH,0
		EVEN
TXT_HELP:	TEXT	"MAPDEBUG COMMANDS:"
		BYTE	0DH,0AH
		TEXT	"  1=PSEL_EN   ENABLE MAPPING (no args)"
		BYTE	0DH,0AH
		TEXT	"  2=PSEL_DIS  DISABLE MAPPING (no args)"
		BYTE	0DH,0AH
		TEXT	"  3=SMREG     SET MAP REG + VERIFY (0504=PAGE:SEG)"
		BYTE	0DH,0AH
		TEXT	"  4=RMREG     READ MAP REG (0504=PAGE:SEG)"
		BYTE	0DH,0AH
		TEXT	"  5=WPGSEG    WRITE TO PAGE (0504=PAGE:SEG 0506=VAL 0508=OFFSET)"
		BYTE	0DH,0AH
		TEXT	"  6=RPGSEG    READ FROM PAGE (0504=PAGE:SEG 0508=OFFSET)"
		BYTE	0DH,0AH
		TEXT	"  7=MAP_CLR   SET ALL SEGMENTS TO PAGE 0 (no args)"
		BYTE	0DH,0AH
		TEXT	"  8=MAP_LST   LIST ALL MAP REGISTERS (no args)"
		BYTE	0DH,0AH
		TEXT	"  9=RDLOOP    CONTINUOUS READ LOOP (0504=PAGE:SEG, RESET TO EXIT)"
		BYTE	0DH,0AH
		TEXT	"  A=PGLOOP    CYCLE ALL PAGES ON SEG (0504=PAGE:SEG, PAGE IGNORED, RESET TO EXIT)"
		BYTE	0DH,0AH
		TEXT	"  B=HELP      THIS MESSAGE (no args)"
		BYTE	0DH,0AH
		TEXT	"  C=SETALL    SET ALL SEGS SEG N=PAGE N (0-14) (no args)"
		BYTE	0DH,0AH
		TEXT	"  D=SEGCYC    PSEL BOUNDARY CYCLE (0504=PAGE:SEG, RESET TO EXIT)"
		BYTE	0DH,0AH
		TEXT	"  E=INIT      INIT SEGS 0-14 SEG N=PAGE N, SEG15=0 (no args)"
		BYTE	0DH,0AH
		TEXT	"  F=CODETEST  CODE@PHYS 0x2000, DATA@PAGED 0x3000 (SEG3=PG3) (no args)"
		BYTE	0DH,0AH
		TEXT	"  10=DUMP     DUMP 64 BYTES (0504=PAGE:SEG 0506=OFFSET)"
		BYTE	0DH,0AH
		TEXT	"  11=COPY     COPY 32 WORDS (0504=DST PAGE:SEG  0506=SRC PAGE:SEG)"
		BYTE	0DH,0AH
		TEXT	"             USE DIFFERENT SEGS FOR SRC AND DST"
		BYTE	0DH,0AH
		TEXT	"             EX: PG5 SEG3->PG6 SEG2: 0504=0602H 0506=0503H"
		BYTE	0DH,0AH
		TEXT	"  12=GO       MAP PAGE:SEG AND JUMP (0504=PAGE:SEG)"
		BYTE	0DH,0AH
		TEXT	"PARAMS: 0502=CMD 0504=PAGE:SEG(HIGH=PAGE LOW=SEG) 0506=SRC PAGE:SEG or VALUE"
		BYTE	0,0
		EVEN
TXT_BADCMD:	TEXT	"BAD CMD"
		BYTE	0
		EVEN
TXT_PSEL_EN:	TEXT	"PSEL:ENABLED"
		BYTE	0
		EVEN
TXT_PSEL_DIS:	TEXT	"PSEL:DISABLED"
		BYTE	0
		EVEN
TXT_MWRSEG:	TEXT	"MAPREG WR SEG:"
		BYTE	0
		EVEN
TXT_MRDSEG:	TEXT	"MAPREG RD SEG:"
		BYTE	0
		EVEN
TXT_PAGE:	TEXT	" PAGE:"
		BYTE	0
		EVEN
TXT_OFFS:	TEXT	" OFFS:"
		BYTE	0
		EVEN
TXT_ADDR:	TEXT	" ADDR:"
		BYTE	0
		EVEN
TXT_READBACK:	TEXT	"READBACK:"
		BYTE	0
		EVEN
TXT_WPGSEG:	TEXT	"WPGSEG SEG:"
		BYTE	0
		EVEN
TXT_RPGSEG:	TEXT	"RPGSEG SEG:"
		BYTE	0
		EVEN
TXT_WROTE:	TEXT	"WROTE:"
		BYTE	0
		EVEN
TXT_READ:	TEXT	"READ:"
		BYTE	0
		EVEN
TXT_MAPCLR:	TEXT	"MAP:INIT - ALL SEGS SET TO PAGE 0"
		BYTE	0
		EVEN
TXT_SEG:	TEXT	"SEG:"
		BYTE	0
		EVEN
TXT_RDLOOP:	TEXT	"RDLOOP:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_DONE:	TEXT	"REGS LOADED - RUN LST TO VERIFY"
		BYTE	0
		EVEN
TXT_INIT:	TEXT	"INIT:SEG N=PAGE N (0-14), SEG15=PAGE0"
		BYTE	0
		EVEN
TXT_SEGCYC:	TEXT	"SEGCYC:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_SEGLOOP:	TEXT	"SETALL:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_PGLOOP:	TEXT	"PGLOOP:RESET TO EXIT"
		BYTE	0
		EVEN
TXT_CODETEST:	TEXT	"CODETEST:CODE@PHYS 2000 DATA@PAGED 3000 SEG3=PG3"
		BYTE	0
		EVEN
TXT_RESULT:	TEXT	" RESULT:"
		BYTE	0
		EVEN
TXT_CTOK:	TEXT	" PASS - CODE EXECUTED FROM PAGED MEMORY"
		BYTE	0
		EVEN
TXT_CTFAIL:	TEXT	" FAIL - EXPECTED BEEF"
		BYTE	0
		EVEN
TXT_DUMP:	TEXT	"DUMP SEG:"
		BYTE	0
		EVEN
TXT_COPY_SRC:	TEXT	"COPY SRC SEG:"
		BYTE	0
		EVEN
TXT_COPY_DST:	TEXT	" -> DST SEG:"
		BYTE	0
		EVEN
TXT_COPY_ERR:	TEXT	"ERROR: SRC AND DST MUST USE DIFFERENT SEGMENTS"
		BYTE	0DH,0AH,0
		EVEN
TXT_CPDONE:	TEXT	"COPY DONE"
		BYTE	0DH,0AH,0
		EVEN
CRLF:
TXT_NL:		BYTE	0DH,0AH,0
		EVEN

FAULT:		TEXT	"EXCEPTION:"
		BYTE	0
		EVEN

;--- CMD 10: Dump 64 bytes (32 words, 4 lines x 8 words) from paged segment ---
; Parameters: 0504 = PAGE:SEG, 0506 = byte offset into segment
; Reads with PSEL active using direct MOV instructions (not XOP),
; so paging is honoured. WHEX R0 reads from workspace (transparent).
DO_DUMP:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;SEGMENT
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;PAGE
	BL	@MAP_SET		;PROGRAM 6116
	BL	@CALC_ADDR		;R2 = SEGMENT BASE ADDRESS
	MOV	@VALUE,R0		;0506 = DUMP OFFSET FOR CMD 10
	ANDI	R0,0FFFH		;KEEP OFFSET WITHIN SELECTED SEGMENT
	A	R0,R2			;R2 = SEGMENT BASE + OFFSET

	MESG	@TXT_DUMP
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SEGMENT
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;PAGE
	MESG	@TXT_OFFS
	MOV	@VALUE,R0
	WHEX	R0			;RAW OFFSET FROM 0506
	MESG	@TXT_ADDR
	MOV	R2,R0
	WHEX	R0			;FINAL SEGMENT+OFFSET ADDRESS
	MESG	@TXT_NL

	PSEL_EN			;ENABLE PSEL - STAYS ON FOR ENTIRE DUMP

	MOV	R2,R4			;R4 = CURRENT ADDRESS (PAGED)
	LI	R3,16			;4 LINES

DUMP_LINE:
	MOV	R4,R0			;DISPLAY LINE ADDRESS
	WHEX	R0
	LI	R1,2000H		;SPACE (0x20 IN MSB) AFTER ADDRESS
	WRITE	R1			;SPACE AFTER ADDRESS

	LI	R5,8			;8 WORDS PER LINE
DUMP_WORD:
	MOV	*R4+,R0			;READ WORD FROM PAGED MEMORY (DIRECT - PSEL ACTIVE)
	WHEX	R0			;DISPLAY (READS R0 FROM WORKSPACE - TRANSPARENT)
	DEC	R5
	JEQ	DUMP_EOL		;END OF LINE
	LI	R1,2000H		;SPACE (0x20 IN MSB)
	WRITE	R1
	JMP	DUMP_WORD
DUMP_EOL:
	MESG	@TXT_NL
	DEC	R3
	JNE	DUMP_LINE

	PSEL_DIS
	B	@EXIT

;--- CMD 11: Copy 32 words from src page/seg to dst page/seg ---
; CALLER MUST USE TWO DIFFERENT SEGMENTS for src and dst.
; 0504 = DST  HIGH BYTE=DST_PAGE, LOW BYTE=DST_SEG
; 0506 = SRC  HIGH BYTE=SRC_PAGE, LOW BYTE=SRC_SEG
; Copy window: SEG_BASE = SEG * 0x1000
; EX: copy pg5/seg3 -> pg6/seg2: 0504=0602H 0506=0503H
DO_COPY:
;--- GUARD: SRC and DST must use different segments ---
	MOV	@VALUE,R0
	ANDI	R0,00FFH		;R0 = SRC SEG
	MOV	@SEG_PAGE,R1
	ANDI	R1,00FFH		;R1 = DST SEG
	C	R0,R1
	JNE	COPY_OK
	MESG	@TXT_COPY_ERR
	B	@EXIT
COPY_OK:
;--- MAP SRC SEGMENT (FROM 0506: HIGH=SRC_PAGE LOW=SRC_SEG) ---
	MOV	@VALUE,R9
	ANDI	R9,00FFH		;R9 = SRC SEG (LOW BYTE)
	MOV	@VALUE,R0
	SWPB	R0
	ANDI	R0,00FFH		;R0 = SRC PAGE (HIGH BYTE)
	BL	@MAP_SET

;--- SRC VIRTUAL BASE = SRC_SEG * 0x1000 ---
	MOV	@VALUE,R4
	ANDI	R4,00FFH		;KEEP LOW BYTE (SEG)
	SWPB	R4
	SLA	R4,4			;R4 = SRC_SEG * 0x1000

;--- MAP DST SEGMENT (FROM 0504: HIGH=DST_PAGE LOW=DST_SEG) ---
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;R9 = DST SEG (LOW BYTE)
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;R0 = DST PAGE (HIGH BYTE)
	BL	@MAP_SET

;--- DST VIRTUAL BASE = DST_SEG * 0x1000 ---
	MOV	@SEG_PAGE,R5
	ANDI	R5,00FFH		;KEEP LOW BYTE (SEG)
	SWPB	R5
	SLA	R5,4			;R5 = DST_SEG * 0x1000

;--- PRINT: COPY SRC PG:XX SEG:XX -> DST PG:XX SEG:XX ---
	MESG	@TXT_COPY_SRC
	MOV	@VALUE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SRC SEG
	MESG	@TXT_PAGE
	MOV	@VALUE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;SRC PAGE
	MESG	@TXT_COPY_DST
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;DST SEG
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;DST PAGE
	MESG	@TXT_NL

;--- ENABLE PSEL - R4=SRC BASE, R5=DST BASE ---
	PSEL_EN

;--- COPY 32 WORDS ---
	LI	R3,32
COPY_LP:
	MOV	*R4+,*R5+
	DEC	R3
	JNE	COPY_LP

;--- DISABLE PSEL ---
	PSEL_DIS
	MESG	@TXT_CPDONE
	B	@EXIT


;	Reads 0xBEEF from page3 at 0x3000, returns in R0
;*******************************************************************

;--- CMD 18: Program SEG:PAGE and jump to virtual base address ---
; 0504 = PAGE:SEG (HIGH=PAGE, LOW=SEG) - consistent with all other commands
; Programs the 6116 for the specified segment, enables PSEL via PSEL_EN,
; sets privilege mode, then jumps to SEG*0x1000.
; Same privilege setup as CMD F. INT2 installed for crash debug.
DO_GO:
	MOV	@SEG_PAGE,R9
	ANDI	R9,00FFH		;R9 = SEG (LOW BYTE)
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH		;R0 = PAGE (HIGH BYTE)
	BL	@MAP_SET		;PROGRAM 6116

;--- COMPUTE JUMP ADDRESS = SEG * 0x1000 ---
	MOV	@SEG_PAGE,R2
	ANDI	R2,00FFH		;KEEP LOW BYTE (SEG)
	SWPB	R2
	SLA	R2,4			;R2 = SEG * 0x1000

;--- PRINT GO INFO ---
	MESG	@TXT_GO
	MOV	@SEG_PAGE,R0
	ANDI	R0,00FFH
	WHEX	R0			;SEG
	MESG	@TXT_PAGE
	MOV	@SEG_PAGE,R0
	SWPB	R0
	ANDI	R0,00FFH
	WHEX	R0			;PAGE
	MESG	@TXT_GOADDR
	WHEX	R2			;JUMP ADDRESS
	MESG	@CRLF

;--- INSTALL INT2 HANDLER (SAME AS CMD F) ---
	LI	R0,0AH
	LI	R1,INT2
	MOV	R1,*R0

;--- ENABLE PSEL AND SET PRIVILEGE MODE (SAME AS CMD F) ---
	PSEL_EN
	CLR	R15
	ORI	R15,0087H
	LST	R15
	B	*R2			;JUMP TO PROGRAM

TXT_GO:		TEXT	"GO SEG:"
		BYTE	0
		EVEN
TXT_GOADDR:	TEXT	" ADDR:"
		BYTE	0
		EVEN
TEST_ROUTINE:
	LI	R2,3000H		;ADDRESS IN PAGE 3
	WHEX	R2
	WHEX	R2
	WHEX	R2
	MESG	@TXT_GOADDR
	MOV	*R2,R0			;READ FROM PAGE 3
	RT
TEST_REND:

;
;
;  INTERRUPT 2 SIGNALS A HARDWARE OF PRIVILEGE FAULT
;

;
INT2:	MESG	@FAULT
	WHEX	R15
	MESG	@CRLF
	RTWP
;
; SNEAKY CHECK TO MAKE SURE EXECUTION IS NOT OCCURRING IN PAGE 0
;
;	AORG	02000H
;	LI	R2,3002H		;ADDRESS IN PAGE 3
;	WHEX	R2
;	MOV	*R2,R0			;READ FROM PAGE 3
;	RT



	END
