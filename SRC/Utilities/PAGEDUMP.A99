;*******************************************************************
;   PAGEDUMP.A99 - Dump memory from any physical page
;   TMS99105 SBC V4
;   Load at 0x1000
;
;   Parameters at fixed addresses (set before running):
;     0x1000: Entry point (B @_main)
;     0x1002: Page number   (0-15, default 0)
;     0x1004: Segment number (0-15, default 2)
;     0x1006: NumWords      (number of words to dump, default 64)
;
;   Usage:
;     Load utility at 0x1000
;     Modify parameters as needed, e.g:
;       E 1002 0001    set page 1
;       E 1004 0003    set segment 3 (address 0x3000)
;       E 1006 0020    dump 32 words
;     Then: 1000G
;
;   Output format:
;     PAGE:xx SEG:xx ADDR:xxxx
;     xxxx: xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx
;     xxxx: xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx
;     ...
;*******************************************************************

        DXOP    WHEX,10
        DXOP    MESG,14

R0      EQU     0
R1      EQU     1
R2      EQU     2
R3      EQU     3
R4      EQU     4
R5      EQU     5
R9      EQU     9
R11     EQU     11

MAP_WIN_BASE    EQU     0E800H
NUM_MAP_ENTRIES EQU     16
WORDS_PER_LINE  EQU     8

        AORG    1000H

;--- Entry point ---
        B       @_main

;--- Parameters (user modifies these before running) ---
PRM_PAGE:   WORD    0               ; page number (0-15)
PRM_SEG:    WORD    2               ; segment number (0-15)
PRM_WORDS:  WORD    64              ; number of words to dump

        LWPI    0250H

_main::

;--- Save current map registers ---
        BL      @MAP_INIT

;--- Map requested segment to requested page ---
        MOV     @PRM_SEG, R9
        MOV     @PRM_PAGE, R0
        BL      @MAP_SET

;--- Print header ---
        MESG    @TXT_PAGE
        MOV     @PRM_PAGE, R0
        WHEX    R0

        MESG    @TXT_SEG
        MOV     @PRM_SEG, R0
        WHEX    R0

;--- Calculate base address: segment * 4096 ---
        MOV     @PRM_SEG, R3
        SLA     R3, 12              ; segment * 0x1000
        MOV     R3, @BASEADDR

        MESG    @TXT_ADDR
        WHEX    R3
        MESG    @TXT_NL

;--- Dump loop ---
        MOV     @PRM_WORDS, R4      ; word count
        MOV     @BASEADDR, R5       ; current address
        CLR     @LINECNT

DUMPLOOP:
;--- Print address at start of each line ---
        MOV     @LINECNT, R0
        CI      R0, 0
        JNE     NOTFIRST
        MESG    @TXT_INDENT
        WHEX    R5
        MESG    @TXT_COLON
NOTFIRST:

;--- Print word ---
        MOV     *R5+, R0
        MESG    @TXT_SPACE
        WHEX    R0

;--- Check end of line ---
        INC     @LINECNT
        MOV     @LINECNT, R0
        CI      R0, WORDS_PER_LINE
        JNE     NOTEND
        MESG    @TXT_NL
        CLR     @LINECNT
        MESG    @TXT_INDENT
        WHEX    R5
        MESG    @TXT_COLON
NOTEND:

        DEC     R4
        JNE     DUMPLOOP

;--- Final newline if mid-line ---
        MOV     @LINECNT, R0
        CI      R0, 0
        JEQ     DONE
        MESG    @TXT_NL

DONE:
;--- Restore all map registers to page 0 ---
        BL      @MAP_INIT
        BLWP    @0F004H

;*******************************************************************
; MAP_INIT - clear all 16 entries to page 0
;*******************************************************************
MAP_INIT:
        LI      R9, MAP_WIN_BASE
        CLR     R0
        LI      R1, NUM_MAP_ENTRIES
MAPI_L: MOV     R0, *R9
        INCT    R9
        DEC     R1
        JNE     MAPI_L
        RT

;*******************************************************************
; MAP_SET - R9=segment, R0=page
;*******************************************************************
MAP_SET:
        SLA     R9, 1
        AI      R9, MAP_WIN_BASE
        SLA     R0, 8
        MOV     R0, *R9
        RT

;*******************************************************************
; Storage
;*******************************************************************
BASEADDR:   WORD    0
LINECNT:    WORD    0

;*******************************************************************
; Messages
;*******************************************************************
TXT_PAGE:   TEXT    "PAGE:"
            BYTE    0
            EVEN
TXT_SEG:    TEXT    " SEG:"
            BYTE    0
            EVEN
TXT_ADDR:   TEXT    " ADDR:"
            BYTE    0
            EVEN
TXT_INDENT: BYTE    0
            EVEN
TXT_COLON:  TEXT    ":"
            BYTE    0
            EVEN
TXT_SPACE:  TEXT    " "
            BYTE    0
            EVEN
TXT_NL:     BYTE    0DH,0AH,0
            EVEN

        END
