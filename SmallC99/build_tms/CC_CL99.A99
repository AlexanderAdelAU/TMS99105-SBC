;* * *  Small-C/Plus Version 1.06a for the TMS 9900 - Cameron * * *
;       Cain, Van Zandt, Hendrix, Yorston, Cameron
;          Original Z80  Version 21st April 1990       
;
R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM CC_CL99
;/*
;** CC_CL99.C -- M38d one-shot command-line parser for SMALLC99
;**
;** AORG >A000, overlay ID 7, physical page 12. The implementation is
;** intentionally parallel to CC_CLI, but derives native .A99 output names
;** and identifies the TMS99105 SBC compiler.
;*/
;#asm
        AORG    0A000H
;#define YES 1
;#define NO  0
;#define NAMEMAX 14
;extern puts();
;extern char srcname[];
;extern char outname[];
;extern int verbose;
;upcase(c)
	EVEN
upcase:
;int c;
;{
;modstk(newsp,save)
;    if(c >= 'a') {
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;zpush()
	MOV R4,R3 ;optimised push/pop
	LI R4,97
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc2
;        if(c <= 'z') return c - 32;
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;zpush()
	MOV R4,R3 ;optimised push/pop
	LI R4,122
;_ccle
	C R3,R4 ;optimised
	JLT $+8
	JEQ $+6
	B @cc3
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;const2(val)
	LI R3,-32
;	zadd()
	A R3,R4
;modstk(newsp,save)
	RET
;    }
cc3:
;modstk(newsp,save)
;    return c;
cc2:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;modstk(newsp,save)
	RET
;}
