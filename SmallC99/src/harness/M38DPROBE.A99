; M38DPROBE.A99 -- syntax proof for emitted byte/stack idioms
        AORG    1000H
R0      EQU     0
R3      EQU     3
R4      EQU     4
SP      EQU     10
R11     EQU     11
WP      EQU     13
BPROBE:
        STWP    WP
        MOVB    @2*R4+1(WP),*R3
        MOVB    @2*R4+1(WP),@BDEST
        MOVB    *R3,R4
        SRL     R4,8
        MOVB    *R3,R4
        SRA     R4,8
        MOV     *SP+,R3
        B       *R11
BDEST   BYTE    0
        EVEN
        END
