  0000                  R0	EQU 0
  0001                  R1	EQU 1
  0002                  R2	EQU 2
  0003                  R3	EQU 3
  0004                  R4	EQU 4
  0008                  R8	EQU 8
  0009                  SL	EQU 9
  0009                  R9	EQU 9
  000A                  SP	EQU 10
  000D                  WP	EQU 13
  000B                  R11	EQU 11
                        	DXOP CALL,6
                        	DXOP RET,7
                        	DXOP WHEX,10
                        	DXOP WRITE,12    ;WRITE CHAR IN MSB 
                        	DXOP	MESG,14
                        	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 
                        
                        ;-------- START MODULE -----------
  0000                  	NAM R99DATA
                        ;/*
                        ; TMS990 Series Cross-Assembler
                        ; File: R99DATA.c
                        ; Single owner of R99 shared assembler storage.
                        ; R99gbl.h contains the declarations used by the normal assembler modules.
                        ; This module deliberately does not include R99gbl.h because Small-C/Plus
                        ; rejects a real definition after an extern declaration of the same object.
                        ; BUFSIZE, LINLEN and SYMBOLS come directly from R99CFG.h.
                        ; SYMLEN and IFDEPTH match the declarations in R99gbl.h.
                        ; */
                        ;#include "R99CFG.h"
                        ;/*
                        ; * R99 build-size configuration.
                        ; *
                        ; * TEMPORARY SBC TESTING PROFILE.
                        ; *
                        ; * Goal: keep the flat R99.COM image below >C000 when loaded at >0500.
                        ; * These reduced capacities are for initial board bring-up only.
                        ; */
                        ;#define LINLEN          128	/*  Must be at least 102: the 4-symbols-per-line table
                        ;                                dump at the end of main writes 4 * 25 + 2 bytes into
                        ;                                linbuf.  At 96 it spilled 6 bytes into binbuf.  */
                        ;#define BUFSIZE          16
                        ;#define SYMBOLS         101	/*  MUST BE ODD - slookup's probe step is d = 1, 3, 5, ...
                        ;                                and its "table full" test is d == SYMBOLS, which an even
                        ;                                SYMBOLS never reaches.  With a power of two the probe
                        ;                                only ever visits 4 of the slots (h advances by k*k).  */
                        ;#define INCLUDE_DEPTH     1
                        ;#define MAXXREF            4
                        ;#define SYMLEN  16
                        ;#define IFDEPTH 16
                        ;#define FILE char
                        ;struct diskbuf {
                        ;	int fd;
                        ;	unsigned char *pointr;
                        ;	unsigned char *endpoint;
                        ;	unsigned char space[BUFSIZE];
                        ;	FILE *fp;
                        ;};
                        ;struct symbtbl {
                        ;	char symname[SYMLEN];
                        ;	unsigned symvalu;
                        ;	unsigned char symflg;
                        ;	unsigned char sympad;	/*  keeps the entry EVEN in length - see below  */
                        ;};
                        ;/*  sympad is not optional.  Without it an entry is 19 bytes, so every odd
                        ;    numbered slot starts on an ODD address and symvalu (offset 16) lands on
                        ;    an odd address too.  The 99105 forces word accesses even, so the store
                        ;    goes to offset 15/16 instead of 16/17 and wipes symname[15].  The value
                        ;    reads back consistently, but the name no longer matches, so symcmp fails
                        ;    and the same symbol gets added twice.  */
                        ;/* Shared assembler storage. */
                        ;struct diskbuf sorbuf, lstbuf, hexbuf;
  0000                  	EVEN
  0000                  sorbuf:	BSS 24
  0018                  	EVEN
  0018                  lstbuf:	BSS 24
  0030                  	EVEN
  0030                  hexbuf:	BSS 24
                        ;struct symbtbl symtbl[SYMBOLS], *symend, *sympoint;
  0048                  	EVEN
  0048                  symtbl:	BSS 2020
  082C                  	EVEN
  082C                  symend:	BSS 2
  082E                  	EVEN
  082E                  sympoint:	BSS 2
                        ;unsigned ifsp;
  0830                  ifsp:	BSS 2
                        ;unsigned ifstack[IFDEPTH + 1];
  0832                  ifstack:	BSS 34
                        ;char *linptr, linbuf[LINLEN];
  0854                  linptr:	BSS 2
  0856                  linbuf:	BSS 128
                        ;unsigned char binbuf[LINLEN], *bptr;
  08D6                  binbuf:	BSS 128
  0956                  bptr:	BSS 2
                        ;int nbytes;
  0958                  nbytes:	BSS 2
                        ;char chksum, hxbytes, *hxlnptr, hxlnbuf[88];
  095A                  chksum:	BSS 1
  095B   00             	EVEN
  095C                  hxbytes:	BSS 1
  095D   00             	EVEN
  095E                  hxlnptr:	BSS 2
  0960                  hxlnbuf:	BSS 88
                        ;unsigned char extflg;
  09B8                  extflg:	BSS 1
  09B9   00             	EVEN
                        ;unsigned char entflg;
  09BA                  entflg:	BSS 1
  09BB   00             	EVEN
                        ;unsigned char relflg;
  09BC                  relflg:	BSS 1
  09BD   00             	EVEN
                        ;int errcode;
  09BE                  errcode:	BSS 2
                        ;int errcount;
  09C0                  errcount:	BSS 2
                        ;int evalerr;
  09C2                  evalerr:	BSS 2
                        ;unsigned backflg, oldattr;
  09C4                  backflg:	BSS 2
  09C6                  oldattr:	BSS 2
                        ;unsigned oldvalu;
  09C8                  oldvalu:	BSS 2
                        ;int curdrive;
  09CA                  curdrive:	BSS 2
                        ;int hexflg;
  09CC                  hexflg:	BSS 2
                        ;int directok;
  09CE                  directok:	BSS 2
                        ;unsigned pc;
  09D0                  pc:	BSS 2
                        ;unsigned progsize;
  09D2                  progsize:	BSS 2
                        ;unsigned address;
  09D4                  address:	BSS 2
                        ;char pass;
  09D6                  pass:	BSS 1
  09D7   00             	EVEN
                        ;char addrmode;
  09D8                  addrmode:	BSS 1
  09D9   00             	EVEN
                        ;char quitflag;
  09DA                  quitflag:	BSS 1
  09DB   00             	EVEN
                        ;unsigned char quoteflg;
  09DC                  quoteflg:	BSS 1
  09DD   00             	EVEN
                        ;unsigned char outchunk,
  09DE                  outchunk:	BSS 1
  09DF   00             	EVEN
                        ;outrem,
  09E0                  outrem:	BSS 1
  09E1   00             	EVEN
                        ;item,
  09E2                  item:	BSS 1
  09E3   00             	EVEN
                        ;type;
  09E4                  type:	BSS 1
  09E5   00             	EVEN
                        ;unsigned field;
  09E6                  field:	BSS 2
                        ;char symbol[SYMLEN],
  09E8                  symbol:	BSS 16
                        ;progname[SYMLEN];
  09F8                  progname:	BSS 16
                        ;unsigned nssymbols;
  0A08                  nssymbols:	BSS 2
                        ;unsigned itemflg[3];
  0A0A                  itemflg:	BSS 6
                        ;unsigned symptr[3];
  0A10                  symptr:	BSS 6
                        	ENT oldvalu
                        	ENT hxlnbuf
                        	ENT errcount
                        	ENT quitflag
                        	ENT bptr
                        	ENT symbol
                        	ENT symend
                        	ENT ifsp
                        	ENT nssymbols
                        	ENT hxlnptr
                        	ENT item
                        	ENT symtbl
                        	ENT linbuf
                        	ENT evalerr
                        	ENT pass
                        	ENT symptr
                        	ENT field
                        	ENT ifstack
                        	ENT extflg
                        	ENT linptr
                        	ENT errcode
                        	ENT nbytes
                        	ENT relflg
                        	ENT type
                        	ENT sympoint
                        	ENT quoteflg
                        	ENT backflg
                        	ENT directok
                        	ENT progname
                        	ENT binbuf
                        	ENT lstbuf
                        	ENT pc
                        	ENT itemflg
                        	ENT chksum
                        	ENT progsize
                        	ENT addrmode
                        	ENT address
                        	ENT oldattr
                        	ENT sorbuf
                        	ENT curdrive
                        	ENT outchunk
                        	ENT outrem
                        	ENT hexflg
                        	ENT hexbuf
                        	ENT hxbytes
                        	ENT entflg
  0A16                  	EVEN
  0A16                  	END

No error(s).
