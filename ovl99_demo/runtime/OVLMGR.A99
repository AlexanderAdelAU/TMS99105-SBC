;*******************************************************************
;  OVLMGR.A99 - the OVL99 overlay manager.  APPLICATION-INDEPENDENT.
;  TMS99105 SBC
;
;  Maps one overlay: every (segment, page) pair in its row of
;  OVL_TABLE.  Applications do not call it directly - the thunks
;  LINK99 -Y writes go through OVCALL, which calls OVLMGR.
;
;    LI   R1,id          ; overlay ID (1 = first overlay in the map)
;    CALL @OVLMGR        ; map it
;
;  Uses R0, R2, R3, R5, R12.  R1 and R4 survive.
;*******************************************************************

;*******************************************************************
;  MEMORY GEOMETRY
;
;    >1000-7FFF   resident / common (page 0)          28K
;    >8000-BFFF   the overlay window: segments 8..11
;    >C000        shell / BDOS / ROM
;
;  An overlay may span up to four pages of the window, mapped
;  together, so calls between its own pages are ordinary direct
;  calls.  Different overlays are mutually exclusive.
;
;  Every executable overlay maps segment 8.  CUR_WINA_ID records
;  the overlay that last mapped it - the window's owner - and OVCALL
;  saves and restores that one ID.  LINK99 -Y refuses a map that
;  breaks this rule.
;
;  MAP_WIN_BASE (>80C0) is a CRU address and is unrelated to memory
;  segment 8.
;*******************************************************************

;*******************************************************************
;  OVL_TABLE (built by LINK99 -Y, in OVLGLUE)
;
;  Row n is overlay ID n; row 0 is unused.  A row is TEN words - five
;  (segment, page) pairs - so its offset is ID*20.  A pair whose
;  SEGMENT is zero ends the row.  Pages are stored explicitly, so the
;  physical pages of one overlay may be anything; LINK99 checks that
;  the SEGMENTS are adjacent.  A map register that already holds the
;  wanted page is not written again.
;*******************************************************************

;--- CONSTANTS ---
	DXOP	PSEL_DIS,0
	DXOP	PSEL_EN,1
	DXOP	CALL,6
	DXOP	RET,7

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
R10	EQU	10
R11	EQU	11
R12	EQU	12
WP	EQU	13
R13	EQU	13
R14	EQU	14
R15	EQU	15
SP	EQU	10

MAP_WIN_BASE:	EQU	080C0H
BYTEWIDE:	EQU	2		;LDCR count 2 = parallel byte transfer

WINA_SEG2:	EQU	16		;window A's FIRST segment * 2
					;(segment 8 -> >8000). Only used to
					;decide when CUR_WINA_ID is updated.
OVLROW:		EQU	20		;bytes per OVL_TABLE row (5 pairs)

;--- the table: built by LINK99 -Y from the overlay map, in OVLGLUE ---
	EXT	OVL_TABLE

;--- PER-SEGMENT "currently loaded page" tracker, indexed segment*2 ---
CURRENT_PAGE:
	WORD	0,0,0,0,0,0,0,0
	WORD	0,0,0,0,0,0,0,0

;--- PER-SEGMENT "currently active overlay ID" tracker ---
CURRENT_ID:
	WORD	0,0,0,0,0,0,0,0
	WORD	0,0,0,0,0,0,0,0

;--- the window's owner: the overlay that last mapped segment 8.
;    OVCALL saves and restores it (EXT CUR_WINA_ID). ---
CUR_WINA_ID:
	WORD	0

;*******************************************************************
;  OVLMGR - Overlay Manager
;
;  Entry: R1 = overlay ID
;  Modifies: R0, R2, R3, R5, R12
;  Preserves: R1, R4, R6-R11, R13-R15  (R1 unchanged on return)
;
;  Walks the row's (segment,page) pairs until a zero segment ends the
;  list, mapping each.
;*******************************************************************
OVLMGR:
	MOV	R1,R3
	SLA	R3,4			;ID*16
	MOV	R1,R5
	SLA	R5,2			;ID*4
	A	R5,R3			;R3 = ID*20, the row's byte offset
	CLR	R5			;R5 = byte offset of the pair

;--- one (segment,page) pair per iteration; segment 0 ends the row ---
OVLM_PAIR:
	MOV	R3,R2
	A	R5,R2			;R2 -> this pair
	MOV	@OVL_TABLE+2(R2),R0	;R0 = physical page. Read the page
					;BEFORE overwriting R2 with the
					;segment, so only one index is live.
	MOV	@OVL_TABLE(R2),R2	;R2 = segment (source is fetched
					;before the destination is written,
					;so reusing R2 is safe here)
	JEQ	OVLMGR_RET		;segment 0 -> no more pages
	SLA	R2,1			;R2 = segment*2, which is both the
					;table word-offset and the CRU scale

	MOV	R1,@CURRENT_ID(R2)	;record the ID for this segment
	CI	R2,WINA_SEG2		;window A's FIRST segment?
	JNE	OVLM_P1
	MOV	R1,@CUR_WINA_ID		;new window owner
OVLM_P1:
	C	R0,@CURRENT_PAGE(R2)
	JEQ	OVLM_NEXT		;this page is already here

	MOV	R0,@CURRENT_PAGE(R2)

	;--- program the map register: PSEL off, LDCR, PSEL on ---
	SLA	R0,8			;page into high byte for LDCR
	PSEL_DIS
	LI	R12,MAP_WIN_BASE
	A	R2,R12			;R12 = MAP_WIN_BASE + segment*2
	LDCR	R0,BYTEWIDE
	PSEL_EN

OVLM_NEXT:
	AI	R5,4			;next pair
	CI	R5,OVLROW
	JNE	OVLM_PAIR

OVLMGR_RET:
	RET


;*******************************************************************
;  OVLMGR_INIT - Initialise overlay manager. Call once at startup.
;*******************************************************************
OVLMGR_INIT:
	LI	R0,CURRENT_PAGE
	LI	R1,32			;16 words CURRENT_PAGE + 16 words
					;CURRENT_ID, contiguous
OVLMGR_INITL:
	CLR	*R0+
	DEC	R1
	JNE	OVLMGR_INITL
	PSEL_EN
	RET

	ENT	OVLMGR
	ENT	OVLMGR_INIT
	ENT	CUR_WINA_ID

	END
