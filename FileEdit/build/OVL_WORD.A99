	JEQ $+6
	B @cc15
;            nline = nline + 1;
;modstk(newsp,save)
;getmem(sym)
	MOV @nline,R4
;inc()
	INC R4
;putmem(sym)
	MOV R4,@nline
;            lastnl = 1;
	LI R4,1
;puttos()
	MOV R4,*SP
;        }
;modstk(newsp,save)
;        else
;jump(label)
	B @cc16
cc15:
;            lastnl = 0;
	CLR R4
;puttos()
	MOV R4,*SP
cc16:
;        if(isword(c)) {
;getloc(sym, off)
	MOV @8(SP),R4 ;optimised load
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @isword
;modstk(newsp,save)
	INCT SP
	MOV R4,R4
	JNE $+6
	B @cc17
;            if(inword == 0) {
;modstk(newsp,save)
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R4
	JEQ $+6
	B @cc18
;                inword = 1;
;modstk(newsp,save)
;getloc(sym, off)
	LI R4,6
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	LI R4,1
;putstk - int
	MOV R4,*R3
;                len = 0;
;getloc(sym, off)
	LI R4,4
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - int
	MOV R4,*R3
;                nword = nword + 1;
;getmem(sym)
	MOV @nword,R4
;inc()
	INC R4
;putmem(sym)
	MOV R4,@nword
;            }
;modstk(newsp,save)
;            if(len < 31)
cc18:
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,31
;_cclt
	C R3,R4 ;optimised
	JLT $+6
	B @cc19
;                word[len] = c;
;getloc(sym, off)
;Char offset
	LI R4,11
	A SP,R4
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load/expr
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV @8(SP),R4 ;optimised load/expr
	MOV R5,R3 ;optimised expr restore
;putstk - char
	MOVB @2*R4+1(WP),*R3
;            len = len + 1;
cc19:
;getloc(sym, off)
	LI R4,4
	A SP,R4
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load/expr
;inc()
	INC R4
	MOV R5,R3 ;optimised expr restore
;putstk - int
	MOV R4,*R3
;        }
;modstk(newsp,save)
;        else if(inword) {
;jump(label)
	B @cc20
cc17:
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R4
	JNE $+6
	B @cc21
;            noteword(word, len);
;modstk(newsp,save)
;getloc(sym, off)
;Char offset
	LI R4,11
	A SP,R4
	DECT SP
	MOV R4,*SP
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @noteword
;modstk(newsp,save)
	AI SP,4
;            inword = 0;
;getloc(sym, off)
	LI R4,6
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - int
	MOV R4,*R3
;            len = 0;
;getloc(sym, off)
	LI R4,4
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - int
	MOV R4,*R3
;        }
;modstk(newsp,save)
;        c = fsgetc();
cc21:
cc20:
;getloc(sym, off)
	LI R4,8
	A SP,R4
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @fsgetc
;modstk(newsp,save)
	MOV *SP+,R3
;putstk - int
	MOV R4,*R3
;    }
;modstk(newsp,save)
;jump(label)
	B @cc13
cc14:
;    if(inword)
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R4
	JNE $+6
	B @cc22
;        noteword(word, len);
;getloc(sym, off)
;Char offset
	LI R4,11
	A SP,R4
	DECT SP
	MOV R4,*SP
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @noteword
;modstk(newsp,save)
	AI SP,4
;    /* Count a final line that has no terminating newline. */
;    if(saw && lastnl == 0)
cc22:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R4
	JNE $+6
	B @cc24
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	CLR R4
;_cceq
	C R3,R4 ;optimised
	JEQ $+6
	B @cc24
	LI R4,1
;jump(label)
	B @cc25
cc24:
	CLR R4
cc25:
	MOV R4,R4
	JNE $+6
	B @cc23
;        nline = nline + 1;
;getmem(sym)
	MOV @nline,R4
;inc()
	INC R4
;putmem(sym)
	MOV R4,@nline
;}
cc23:
;modstk(newsp,save)
	AI SP,42
;modstk(newsp,save)
	RET
	EXT fsgetc
	ENT wordscan
	EXT noteword
	ENT isword
	EXT nline
	EXT nword
	EVEN
	END

