R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R5	EQU 5
R6	EQU 6
R7	EQU 7
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM OVL_WORD
;/*
;** OVL_WORD.C -- FILESTAT word and line analysis overlay.
;**
;** This module runs at >8000.  Results needed after it returns are written to
;** resident FILEDATA storage.
;*/
;#asm
        AORG    08000H
;extern fsgetc();
;extern noteword();
;extern int nline;
;extern int nword;
;isword(c)
	EVEN
isword:
;int c;
;{
;modstk(newsp,save)
;    if(c >= 'A' && c <= 'Z')
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,65
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc3
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,90
;_ccle
	C R3,R4 ;optimised
	JLT $+8
	JEQ $+6
	B @cc3
	LI R4,1
;jump(label)
	B @cc4
cc3:
	CLR R4
cc4:
	MOV R4,R4
	JNE $+6
	B @cc2
;        return 1;
	LI R4,1
;modstk(newsp,save)
	RET
;    if(c >= 'a' && c <= 'z')
cc2:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,97
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc6
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,122
;_ccle
	C R3,R4 ;optimised
	JLT $+8
	JEQ $+6
	B @cc6
	LI R4,1
;jump(label)
	B @cc7
cc6:
	CLR R4
cc7:
	MOV R4,R4
	JNE $+6
	B @cc5
;        return 1;
	LI R4,1
;modstk(newsp,save)
	RET
;    if(c >= '0' && c <= '9')
cc5:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,48
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc9
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,57
;_ccle
	C R3,R4 ;optimised
	JLT $+8
	JEQ $+6
	B @cc9
	LI R4,1
;jump(label)
	B @cc10
cc9:
	CLR R4
cc10:
	MOV R4,R4
	JNE $+6
	B @cc8
;        return 1;
	LI R4,1
;modstk(newsp,save)
	RET
;    if(c == '_')
cc8:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,95
;_cceq
	C R3,R4 ;optimised
	JEQ $+6
	B @cc11
;        return 1;
	LI R4,1
;modstk(newsp,save)
	RET
;    return 0;
cc11:
	CLR R4
;modstk(newsp,save)
	RET
;}
;wordscan()
	EVEN
wordscan:
;{
