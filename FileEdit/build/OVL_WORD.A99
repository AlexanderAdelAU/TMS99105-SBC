;    inword = 0;
;modstk(newsp,save)
	AI SP,-42
;getloc(sym, off)
	LI R4,6
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - int
	MOV R4,*R3
;    len = 0;
;getloc(sym, off)
	LI R4,4
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - int
	MOV R4,*R3
;    saw = 0;
	CLR R4
;put2tos()
	MOV R4,@2(SP)
;    lastnl = 1;
	LI R4,1
;puttos()
	MOV R4,*SP
;    c = fsgetc();
;getloc(sym, off)
	LI R4,8
	A SP,R4
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @fsgetc
;modstk(newsp,save)
	MOV *SP+,R3
;putstk - int
	MOV R4,*R3
;    while(c != -1) {
cc13:
;getloc(sym, off)
	MOV @8(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	SETO R4
;_ccne
	C R3,R4 ;optimised
	JNE $+6
	B @cc14
;        saw = 1;
;modstk(newsp,save)
	LI R4,1
;put2tos()
	MOV R4,@2(SP)
