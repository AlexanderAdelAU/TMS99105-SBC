;int line, col;
;{
;    int len;
;    len = ebllen(line);
;modstk(newsp,save)
	DECT SP
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @ebllen
;modstk(newsp,save)
	INCT SP
;puttos()
	MOV R4,*SP
;    if(col < 0) col = 0;
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
;lt0(label)
	MOV R4,R4
	JLT $+6
	B @cc5
;getloc(sym, off)
	LI R4,4
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - int
	MOV R4,*R3
;    if(col > len) col = len;
cc5:
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
	MOV R5,R3 ;optimised expr restore
;_ccgt
	C R3,R4 ;optimised
	JGT $+6
	B @cc6
;getloc(sym, off)
	LI R4,4
	A SP,R4
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
	MOV R5,R3 ;optimised expr restore
;putstk - int
	MOV R4,*R3
;    return col;
cc6:
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
;modstk(newsp,save)
	INCT SP
	RET
;}
