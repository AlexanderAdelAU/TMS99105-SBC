R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R5	EQU 5
R6	EQU 6
R7	EQU 7
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM OVL_EDIT
;/*
;** OVL_EDIT.C -- FileEdit Step 7 one-key editor operation overlay.
;**
;** This overlay owns no persistent state.  All cursor/document variables live
;** resident, and this module processes exactly one terminal key then returns.
;** OVL_VIEW is mapped separately by the small resident EDITCTL controller.
;*/
;#asm
        AORG    08000H
;extern puts();
;extern fssave();
;extern trmkey();
;extern trmshow();
;extern trmhide();
;extern trmclear();
