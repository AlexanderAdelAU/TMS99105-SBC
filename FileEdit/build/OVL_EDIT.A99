;/* Clamp a line number to the editor's logical range. */
;eclamp(n)
	EVEN
eclamp:
;int n;
;{
;modstk(newsp,save)
;    if(n < 1) n = 1;
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,1
;_cclt
	C R3,R4 ;optimised
	JLT $+6
	B @cc2
	LI R4,1
;put2tos()
	MOV R4,@2(SP)
;    if(n > etotal) n = etotal;
cc2:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	MOV @etotal,R4
;_ccgt
	C R3,R4 ;optimised
	JGT $+6
	B @cc3
;getmem(sym)
	MOV @etotal,R4
;put2tos()
	MOV R4,@2(SP)
;    return n;
cc3:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;modstk(newsp,save)
	RET
;}
;/* Clamp actual column to the length of a line. */
