;putmem(sym)
	MOV R4,@eblines
;    vidx = 0;
	CLR R4
;putmem(sym)
	MOV R4,@vidx
;    ebdirty = 0;
	CLR R4
;putmem(sym)
	MOV R4,@ebdirty
;    ebsaved = 0;
	CLR R4
;putmem(sym)
	MOV R4,@ebsaved
;    ebvalid = 1;
	LI R4,1
;putmem(sym)
	MOV R4,@ebvalid
;    ebbase[0] = 0;
;getmem(sym)
	MOV @ebbase,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - char
	MOVB @2*R4+1(WP),*R3
;}
