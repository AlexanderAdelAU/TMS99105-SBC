;/*
;** Return the editor cursor-line count.
;** A terminal CR exposes one final empty editable line, just as a modern
;** screen editor does.  The read-only FILESTAT line count remains unchanged.
;*/
;ebedln()
	EVEN
ebedln:
;{
;    if(eblen == 0)
;modstk(newsp,save)
;getmem(sym)
