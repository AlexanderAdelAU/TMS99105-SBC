;	dec()
	DEC R4
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
;indirect ccgchar
	MOVB *R4,R4
	SRA R4,8
	MOV R4,R3 ;optimised push/pop
	LI R4,13
;_cceq
	C R3,R4 ;optimised
	JEQ $+6
	B @cc23
;        return eblines + 1;
;getmem(sym)
	MOV @eblines,R4
;inc()
	INC R4
;modstk(newsp,save)
	RET
;    if(eblines == 0)
