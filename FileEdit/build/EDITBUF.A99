;getmem(sym)
	MOV @eblines,R4
	MOV R4,R4
	JEQ $+6
	B @cc24
;        return 1;
	LI R4,1
;modstk(newsp,save)
	RET
;    return eblines;
cc24:
;getmem(sym)
	MOV @eblines,R4
;modstk(newsp,save)
