R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R5	EQU 5
R6	EQU 6
R7	EQU 7
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM EDITBUF
;/*
;** EDITBUF.C -- resident editor-buffer services (Step 6).
;**
;** The text arena remains >9000-BFFF and is still invisible to the user.  Step
;** 6 adds persistent document lifecycle: safe load-by-name, New and a validity
;** flag so Open failures never destroy the document already in memory.
;*/
;extern fopen();
;extern fclose();
;extern fgetc();
;extern puts();
;extern fsset();
;extern char *fsname;
;extern int fsexist;
;char *ebbase;
