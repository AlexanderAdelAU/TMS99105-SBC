                        ;*******************************************************************
                        ; CONRX.A99 -- FileEdit resident TMS9902 RX interrupt queue test.
                        ;
                        ; Hooks only the INT4 PC word in writable common RAM.  The MONITOR's
                        ; existing INT4 workspace is retained.  RX characters are drained into a
                        ; 64-byte circular buffer. After servicing its RX condition, FileEdit always
                        ; chains to the previously installed INT4 handler, which owns the final RTWP.
                        ;
                        ; CRU assumptions verified against the supplied MONITOR source:
                        ;   CRUBASE >0080
                        ;   TB 21   receive buffer register full
                        ;   bit 18  receiver interrupt enable / acknowledge; re-armed per char
                        ;
                        ; Public symbols are <= 8 characters for the Small-C/Plus toolchain.
                        ;*******************************************************************
                        
                                DXOP    RET,7
                        
  0000                  R0      EQU     0
  0001                  R1      EQU     1
  0002                  R2      EQU     2
  0003                  R3      EQU     3
  000C                  R12     EQU     12
                        
  0080                  CRUBASE EQU     0080H
  0010                  INT4WP  EQU     0010H
  0012                  INT4PC  EQU     0012H
  003F                  RXMASK  EQU     003FH          ; 64-byte queue, indices 0..63
                        
                        ;-------------------------------------------------------------------
                        ; rxinit -- install resident INT4 PC hook and enable 9902 RX IRQ.
                        ;           Idempotent.  Existing INT4 WP/PC and caller status are saved.
                        ;           FileEdit runs with LIMI 7 while the hook is active.
                        ;-------------------------------------------------------------------
                        rxinit:
  0000   C020 017C              MOV     @RXACT,R0
  0004   1626                   JNE     RXI_RET
                        
  0006   02C0                   STST    R0
  0008   C800 017A              MOV     R0,@OLDST
  000C   0300 0000              LIMI    0
                        
  0010   C020 0010              MOV     @INT4WP,R0
  0014   C800 0176              MOV     R0,@OLDWP
  0018   C020 0012              MOV     @INT4PC,R0
  001C   C800 0178              MOV     R0,@OLDPC
                        
  0020   04E0 017E              CLR     @RXHEAD
  0024   04E0 0180              CLR     @RXTAIL
  0028   04E0 0182              CLR     @RXOVFL
  002C   04E0 0184              CLR     @rxchar
                        
                                ; Keep MONITOR's INT4 workspace; replace only handler PC.
  0030   0200 00A6              LI      R0,RXISR
  0034   C800 0012              MOV     R0,@INT4PC
                        
                                ; Drain one stale byte, if present, before enabling RX IRQ.
  0038   020C 0080              LI      R12,CRUBASE
  003C   1F15                   TB      21
  003E   1602                   JNE     RXI_EN
  0040   04C1                   CLR     R1
  0042   3601                   STCR    R1,8
                        
  0044   1D12           RXI_EN  SBO     18             ; receiver interrupt enable
  0046   0200 0001              LI      R0,1
  004A   C800 017C              MOV     R0,@RXACT
                        
                                ; FileEdit needs INT4 admitted while the RX hook is active.
                                ; MONITOR itself normally runs with LIMI 7.
  004E   0300 0007              LIMI    7
  0052   2DC0           RXI_RET RET
                        
                        ;-------------------------------------------------------------------
                        ; rxfini -- disable RX IRQ and restore original INT4 vector.
                        ;-------------------------------------------------------------------
                        rxfini:
  0054   C020 017C              MOV     @RXACT,R0
  0058   1312                   JEQ     RXF_RET
                        
  005A   0300 0000              LIMI    0
                        
  005E   020C 0080              LI      R12,CRUBASE
  0062   1E12                   SBZ     18             ; receiver interrupt disable
                        
  0064   C020 0176              MOV     @OLDWP,R0
  0068   C800 0010              MOV     R0,@INT4WP
  006C   C020 0178              MOV     @OLDPC,R0
  0070   C800 0012              MOV     R0,@INT4PC
  0074   04E0 017C              CLR     @RXACT
                        
  0078   C020 017A              MOV     @OLDST,R0
  007C   0080                   LST     R0
  007E   2DC0           RXF_RET RET
                        
                        ;-------------------------------------------------------------------
                        ; rxwait -- block until one queued character is available.
                        ;           Result is deposited in resident word rxchar (0..255).
                        ;           Mainline owns RXTAIL; ISR owns RXHEAD.
                        ;-------------------------------------------------------------------
                        rxwait:
  0080   C020 0180      RXW_LP  MOV     @RXTAIL,R0
  0084   8800 017E              C       R0,@RXHEAD
  0088   13FB                   JEQ     RXW_LP
                        
  008A   0201 0186              LI      R1,RXBUF
  008E   A040                   A       R0,R1
  0090   04C2                   CLR     R2
  0092   D091                   MOVB    *R1,R2
  0094   06C2                   SWPB    R2
  0096   C802 0184              MOV     R2,@rxchar
                        
  009A   0580                   INC     R0
  009C   0240 003F              ANDI    R0,RXMASK
  00A0   C800 0180              MOV     R0,@RXTAIL
  00A4   2DC0                   RET
                        
                        ;-------------------------------------------------------------------
                        ; RXISR -- INT4 resident handler.
                        ;
                        ; Uses the existing MONITOR INT4 workspace.  R13/R14/R15 therefore retain
                        ; the interrupted context exactly as for the original handler.  If an RX byte
                        ; is ready, consume it immediately into the queue.  Always chain to the saved
                        ; original INT4 handler so simultaneous/pure timer interrupts are processed.
                        ;-------------------------------------------------------------------
                        RXISR:
  00A6   020C 0080              LI      R12,CRUBASE
  00AA   1F15                   TB      21             ; receive buffer register full?
  00AC   1616                   JNE     RX_CHAIN       ; no: let original INT4 handler inspect timer
                        
                                ; Acknowledge/inhibit this receive interrupt before draining RBR.
                                ; TI's 9902 receive example explicitly clears bit 18 after service;
                                ; leaving it set causes INT4 to remain asserted/re-enter after RTWP.
  00AE   1E12                   SBZ     18
  00B0   04C1                   CLR     R1
  00B2   3601                   STCR    R1,8           ; received byte in MSB of R1; drain RBR
                        
                                ; Re-arm receiver interrupts for the next character.  If a new byte
                                ; arrived while inhibited, enabling bit 18 will assert INT4 again.
  00B4   1D12                   SBO     18
                        
  00B6   C020 017E              MOV     @RXHEAD,R0
  00BA   C080                   MOV     R0,R2
  00BC   0582                   INC     R2
  00BE   0242 003F              ANDI    R2,RXMASK      ; next head
  00C2   8802 0180              C       R2,@RXTAIL
  00C6   1307                   JEQ     RX_DROP        ; queue full: consume hardware byte, drop it
                        
  00C8   0203 0186              LI      R3,RXBUF
  00CC   A0C0                   A       R0,R3
  00CE   D4C1                   MOVB    R1,*R3
  00D0   C802 017E              MOV     R2,@RXHEAD
  00D4   1002                   JMP     RX_CHAIN
                        
  00D6   05A0 0182      RX_DROP INC     @RXOVFL
                        
                        RX_CHAIN:
                                ; We are still executing in the MONITOR INT4 workspace.
                                ; Do not touch a C/Small-C stack here: there is no valid application
                                ; SP in this workspace.  R12 was loaded explicitly above for serial
                                ; TMS9902 CRU access.
                                ;
                                ; FileEdit is a cooperative first-stage INT4 hook.  After servicing
                                ; only its RX condition, ALWAYS chain to the previously installed
                                ; handler.  That owner may service the TMS9902 timer or any other
                                ; INT4 responsibility and performs the one and only final RTWP.
  00DA   C020 0178              MOV     @OLDPC,R0
  00DE   0450                   B       *R0
                        
                        
                        ;-------------------------------------------------------------------
                        ; rxtest -- isolated INT4/timer hook diagnostic.
                        ;
                        ; Installs a temporary INT4 PC hook, programs the TMS9902 interval
                        ; timer exactly like the supplied MONITOR SETTIMER path, and blocks
                        ; until eight timer interrupts have reached our handler.  RX IRQ is
                        ; not enabled for this test.  Original vector/status are restored.
                        ;-------------------------------------------------------------------
                        rxtest:
  00E0   02C0                   STST    R0
  00E2   C800 016E              MOV     R0,@TSTST
  00E6   0300 0000              LIMI    0
                        
  00EA   C020 0010              MOV     @INT4WP,R0
  00EE   C800 016A              MOV     R0,@TSTWP
  00F2   C020 0012              MOV     @INT4PC,R0
  00F6   C800 016C              MOV     R0,@TSTPC
                        
  00FA   04E0 0172              CLR     @rxticks
  00FE   04E0 0170              CLR     @TSTDONE
                        
  0102   0200 0146              LI      R0,TSTISR
  0106   C800 0012              MOV     R0,@INT4PC
                        
                                ; Same timer setup used by MONITOR SETTIMER.
  010A   020C 0080              LI      R12,CRUBASE
  010E   1E14                   SBZ     20             ; reset/disable timer interrupt
  0110   1E0E                   SBZ     14
  0112   1D0D                   SBO     13             ; load interval timer only
  0114   3220 0174              LDCR    @TSTINT,8
  0118   1D14                   SBO     20             ; enable timer interrupt
                        
  011A   0300 0007              LIMI    7
  011E   C020 0170      TSTWAIT MOV     @TSTDONE,R0
  0122   13FD                   JEQ     TSTWAIT
                        
  0124   0300 0000              LIMI    0
  0128   020C 0080              LI      R12,CRUBASE
  012C   1E14                   SBZ     20
                        
  012E   C020 016A              MOV     @TSTWP,R0
  0132   C800 0010              MOV     R0,@INT4WP
  0136   C020 016C              MOV     @TSTPC,R0
  013A   C800 0012              MOV     R0,@INT4PC
                        
  013E   C020 016E              MOV     @TSTST,R0
  0142   0080                   LST     R0
  0144   2DC0                   RET
                        
                        ; Timer-only ISR used by rxtest.  It intentionally does not chain to
                        ; MONITOR; during this short diagnostic it owns the programmed timer.
                        TSTISR:
  0146   020C 0080              LI      R12,CRUBASE
  014A   1F19                   TB      25             ; timer elapsed status?
  014C   160D                   JNE     TSTIRET        ; unexpected INT4: leave immediately
                        
  014E   1D14                   SBO     20             ; reset timer interrupt condition
  0150   05A0 0172              INC     @rxticks
  0154   C020 0172              MOV     @rxticks,R0
  0158   0280 0008              CI      R0,8
  015C   1105                   JLT     TSTIRET
                        
  015E   1E14                   SBZ     20             ; enough ticks: stop timer IRQ
  0160   0200 0001              LI      R0,1
  0164   C800 0170              MOV     R0,@TSTDONE
  0168   0380           TSTIRET RTWP
                        
  016A   0000           TSTWP   WORD    0
  016C   0000           TSTPC   WORD    0
  016E   0000           TSTST   WORD    0
  0170   0000           TSTDONE WORD    0
  0172   0000           rxticks WORD    0
  0174   FF             TSTINT  BYTE    255            ; MONITOR comment: about 16 ms
  0175   00                     EVEN
                        
                        ;-------------------------------------------------------------------
                        ; Resident queue/state.
                        ;-------------------------------------------------------------------
  0176   0000           OLDWP   WORD    0
  0178   0000           OLDPC   WORD    0
  017A   0000           OLDST   WORD    0
  017C   0000           RXACT   WORD    0
  017E   0000           RXHEAD  WORD    0
  0180   0000           RXTAIL  WORD    0
  0182   0000           RXOVFL  WORD    0
  0184   0000           rxchar  WORD    0
  0186                  RXBUF   BSS     64
  01C6                          EVEN
                        
                                ENT     rxinit
                                ENT     rxfini
                                ENT     rxwait
                                ENT     rxchar
                                ENT     rxtest
                                ENT     rxticks
  01C6                          END

No error(s).
CRUBASE           0080   INT4PC            0012   INT4WP            0010   OLDPC             0178'  
OLDST             017A'  OLDWP             0176'  R0                0000   R1                0001   
R12               000C   R2                0002   R3                0003   RET               2DC0'  
RXACT             017C'  RXBUF             0186'  RXF_RET           007E'  RXHEAD            017E'  
RXISR             00A6'  RXI_EN            0044'  RXI_RET           0052'  RXMASK            003F   
RXOVFL            0182'  RXTAIL            0180'  RXW_LP            0080'  RX_CHAIN          00DA'  
RX_DROP           00D6'  TSTDONE           0170'  TSTINT            0174'  TSTIRET           0168'  
TSTISR            0146'  TSTPC             016C'  TSTST             016E'  TSTWAIT           011E'  
TSTWP             016A'  rxchar            0184'  rxfini            0054'  rxinit            0000'  
rxtest            00E0'  rxticks           0172'  rxwait            0080'  
