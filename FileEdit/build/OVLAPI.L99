                        ;*******************************************************************
                        ; OVLAPI.A99 -- FILESTAT resident overlay entry adapters.
                        ;
                        ; FILESTAT-specific glue only.  The shared OVLMGR.A99 is not modified.
                        ;
                        ; Small-C/Plus and the shared overlay framework use XOP6 CALL / XOP7 RET.
                        ; Each wrapper follows the proven sequence:
                        ;
                        ;       LI   R1,overlay_id
                        ;       CALL @OVLMGR
                        ;       CALL @overlay_entry
                        ;       RET
                        ;
                        ; ovlinit must be called once before FILESTAT performs normal application
                        ; work.  It calls the shared manager's proven OVLMGR_INIT entry unchanged.
                        ;*******************************************************************
                        
                                DXOP    CALL,6
                                DXOP    RET,7
                        
  0001                  R1      EQU     1
                        
                                INCL    "OVLDEFS.INC"
                        ; OVLDEFS.INC -- FILESTAT overlay IDs.
                        ; ID zero is unused.  All overlays execute in virtual segment 8 (>8000-8FFF).
                        
  0001                  OVL_WORD    EQU 1
  0002                  OVL_CHAR    EQU 2
  0003                  OVL_RPT     EQU 3
  0004                  OVL_VIEW    EQU 4
  0005                  OVL_EDIT    EQU 5
                                INCL    "OVLADDR.INC"
                        ;------------------------------------------------------------
                        ;  OVLADDR.INC
                        ;
                        ;  AUTO-GENERATED BY DREL - DO NOT EDIT
                        ;
                        ;  Generated from overlay .R99 EPOINT records.
                        ;  Overlay IDs and aliases came from the DREL command line.
                        ;
                        ;  Source descriptors:
                        ;      OVL_WORD.R99=2,1,wordscan:O_WORD
                        ;      OVL_CHAR.R99=3,2,charscan:O_CHAR
                        ;      OVL_RPT.R99=4,3,report:O_RPT
                        ;      OVL_VIEW.R99=5,4,viewfile:O_VIEW
                        ;      OVL_EDIT.R99=6,5,editstep:O_EDIT
                        ;------------------------------------------------------------
                        
  80DC                  O_WORD     EQU 80DCH	; wordscan
  8000                  O_CHAR     EQU 8000H	; charscan
  8000                  O_RPT      EQU 8000H	; report
  83EC                  O_VIEW     EQU 83ECH	; viewfile
  8BF0                  O_EDIT     EQU 8BF0H	; editstep
                        
                                EXT     OVLMGR
                                EXT     OVLMGR_INIT
                        
                        ovlinit:
  0000   2DA0 0000              CALL    @OVLMGR_INIT
  0004   2DC0                   RET
                        
                        runword:
  0006   0201 0001              LI      R1,OVL_WORD
  000A   2DA0 0000              CALL    @OVLMGR
  000E   2DA0 80DC              CALL    @O_WORD
  0012   2DC0                   RET
                        
                        runchar:
  0014   0201 0002              LI      R1,OVL_CHAR
  0018   2DA0 0000              CALL    @OVLMGR
  001C   2DA0 8000              CALL    @O_CHAR
  0020   2DC0                   RET
                        
                        runrpt:
  0022   0201 0003              LI      R1,OVL_RPT
  0026   2DA0 0000              CALL    @OVLMGR
  002A   2DA0 8000              CALL    @O_RPT
  002E   2DC0                   RET
                        
                        runview:
  0030   0201 0004              LI      R1,OVL_VIEW
  0034   2DA0 0000              CALL    @OVLMGR
  0038   2DA0 83EC              CALL    @O_VIEW
  003C   2DC0                   RET
                        
                        runedit:
  003E   0201 0005              LI      R1,OVL_EDIT
  0042   2DA0 0000              CALL    @OVLMGR
  0046   2DA0 8BF0              CALL    @O_EDIT
  004A   2DC0                   RET
                        
                                ENT     ovlinit
                                ENT     runword
                                ENT     runchar
                                ENT     runrpt
                                ENT     runview
                                ENT     runedit
  004C                          END

No error(s).
CALL              2D80'  OVLMGR            0000*  OVLMGR_INIT       0000*  OVL_CHAR          0002   
OVL_EDIT          0005   OVL_RPT           0003   OVL_VIEW          0004   OVL_WORD          0001   
O_CHAR            8000   O_EDIT            8BF0   O_RPT             8000   O_VIEW            83EC   
O_WORD            80DC   R1                0001   RET               2DC0'  ovlinit           0000'  
runchar           0014'  runedit           003E'  runrpt            0022'  runview           0030'  
runword           0006'  
