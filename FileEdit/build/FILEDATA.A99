R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R5	EQU 5
R6	EQU 6
R7	EQU 7
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM FILEDATA
;/*
;** FILEDATA.C -- FILESTAT resident statistics/document storage (Step 6).
;**
;** The current editor filename is now resident writable storage rather than a
;** pointer into argv.  Open/New/Save As may therefore change document identity
;** without restarting FILESTAT.  All external identifiers remain eight
;** characters or fewer for Small-C/Plus.
;*/
;extern puts();
;extern putchar();
;char fsfile[16];
fsfile:	BSS 16
;char *fsname;
fsname:	BSS 2
;int fsunit;
fsunit:	BSS 2
;int dolst;
dolst:	BSS 2
;char fsbak[16];
fsbak:	BSS 16
;int fsexist;
fsexist:	BSS 2
;int nline;
nline:	BSS 2
;int nword;
nword:	BSS 2
;int nchar;
nchar:	BSS 2
;int nalpha;
nalpha:	BSS 2
;int ndigit;
ndigit:	BSS 2
;int nspace;
nspace:	BSS 2
;int npunct;
npunct:	BSS 2
;int longlen;
longlen:	BSS 2
;char longword[32];
longword:	BSS 32
