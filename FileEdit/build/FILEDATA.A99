;fsset(p)
	EVEN
fsset:
;char *p;
;{
;modstk(newsp,save)
;    int i;
;    fsname = fsfile;
;modstk(newsp,save)
	DECT SP
;address(ptr)
	LI R4,fsfile
;putmem(sym)
	MOV R4,@fsname
;    i = 0;
	CLR R4
;puttos()
	MOV R4,*SP
;    while(p[i] != 0 && i < 15) {
cc2:
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
;indirect ccgchar
	MOVB *R4,R4
	SRA R4,8
	MOV R4,R3 ;optimised push/pop
	CLR R4
;_ccne
	C R3,R4 ;optimised
	JNE $+6
	B @cc4
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,15
;_cclt
	C R3,R4 ;optimised
	JLT $+6
	B @cc4
	LI R4,1
;jump(label)
	B @cc5
cc4:
	CLR R4
cc5:
	MOV R4,R4
	JNE $+6
	B @cc3
;        fsfile[i] = p[i];
;modstk(newsp,save)
;address(ptr)
	LI R4,fsfile
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
	DECT SP
	MOV R4,*SP
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load/expr
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
;indirect ccgchar
	MOVB *R4,R4
	SRA R4,8
	MOV *SP+,R3
;putstk - char
	MOVB @2*R4+1(WP),*R3
;        i = i + 1;
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
;inc()
	INC R4
;puttos()
	MOV R4,*SP
;    }
;modstk(newsp,save)
;jump(label)
	B @cc2
cc3:
;    fsfile[i] = 0;
;address(ptr)
	LI R4,fsfile
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - char
	MOVB @2*R4+1(WP),*R3
;    return i;
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
;modstk(newsp,save)
	INCT SP
	RET
;}
