R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R5	EQU 5
R6	EQU 6
R7	EQU 7
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM VIEWCTL
;/*
;** VIEWCTL.C -- resident read-only viewer controller (Step 4).
;**
;** Step 4 no longer rewinds/re-reads the disk file on each redraw.  EDITBUF
;** loads the file once into >9000-BFFF; this controller navigates that stable
;** memory image while OVL_VIEW continues to render one frame at >8000.
;*/
;extern ebseek();
;extern runview();
;extern trmkey();
;extern trmshow();
;extern trmhide();
;extern trmclear();
;extern int eblines;
;/* Persistent viewer state consumed by OVL_VIEW. */
;int vtop;
vtop:	BSS 2
;int vtotal;
vtotal:	BSS 2
;int vmode;
vmode:	BSS 2
;int vleft;
vleft:	BSS 2
;vclamp(top, total)
	EVEN
vclamp:
;int top, total;
;{
;modstk(newsp,save)
;    int max;
;    max = total - 19;
;modstk(newsp,save)
	DECT SP
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
;const2(val)
	LI R3,-19
;	zadd()
	A R3,R4
;puttos()
	MOV R4,*SP
;    if(max < 1)
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,1
;_cclt
	C R3,R4 ;optimised
	JLT $+6
	B @cc2
;        max = 1;
	LI R4,1
;puttos()
	MOV R4,*SP
;    if(top < 1)
cc2:
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,1
;_cclt
	C R3,R4 ;optimised
	JLT $+6
	B @cc3
;        top = 1;
;getloc(sym, off)
	LI R4,6
	A SP,R4
	MOV R4,R3 ;optimised push/pop
	LI R4,1
;putstk - int
	MOV R4,*R3
;    if(top > max)
cc3:
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
	MOV R5,R3 ;optimised expr restore
;_ccgt
	C R3,R4 ;optimised
	JGT $+6
	B @cc4
;        top = max;
;getloc(sym, off)
	LI R4,6
	A SP,R4
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
	MOV R5,R3 ;optimised expr restore
;putstk - int
	MOV R4,*R3
;    return top;
cc4:
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
;modstk(newsp,save)
	INCT SP
	RET
;}
