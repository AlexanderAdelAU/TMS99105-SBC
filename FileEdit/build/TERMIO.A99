;zcall()
	CALL @putchar
;modstk(newsp,save)
	INCT SP
;    puts(s);
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @puts
;modstk(newsp,save)
	INCT SP
;}
