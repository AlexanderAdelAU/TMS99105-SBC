	DECT SP
	MOV R4,*SP
	LI R4,1
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @trmpos
;modstk(newsp,save)
	AI SP,4
;    trmclrln();
;zcall()
	CALL @trmclrln
;modstk(newsp,save)
;    n = 0;
	CLR R4
;puttos()
	MOV R4,*SP
;    while(n < 79) {
cc16:
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,79
;_cclt
	C R3,R4 ;optimised
	JLT $+6
	B @cc17
;        putchar('-');
;modstk(newsp,save)
	LI R4,45
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @putchar
;modstk(newsp,save)
