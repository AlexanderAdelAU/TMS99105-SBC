trmnum:
;int n;
;{
;    if(n < 0) {
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;lt0(label)
	MOV R4,R4
	JLT $+6
	B @cc9
;        putchar('-');
;modstk(newsp,save)
	LI R4,45
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @putchar
;modstk(newsp,save)
	INCT SP
;        n = -n;
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;neg()
	NEG R4
;put2tos()
	MOV R4,@2(SP)
;    }
;modstk(newsp,save)
;    if(n >= 10)
cc9:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,10
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc10
;        trmnum(n / 10);
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,10
	BL @_ccdiv##
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @trmnum
;modstk(newsp,save)
	INCT SP
;    putchar('0' + (n % 10));
cc10:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,10
	BL @_ccdiv##
;swap()
	MOV R3,R0;;
	MOV R4,R3
	MOV R0,R4
;const2(val)
	LI R3,48
;	zadd()
	A R3,R4
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @putchar
;modstk(newsp,save)
	INCT SP
;}
